@model IEnumerable<Green_Basket.Models.ViewModels.UserItemViewModel>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "User & Role Management";
    Layout = "_Layout";
}

<partial name="Components/_PageHeader" model='new PageHeaderModel {
    Title = "User & Role Access Management",
    Subtitle = "Configure staff accounts, disaster recovery coordinators, and administrative access.",
    ActionText = "New User",
    ActionModalTarget = "createUserModal",
    ActionIcon = "user-plus",
    RequiredRole = "Admin"
}' />

<div id="users-table" class="gb-card overflow-hidden">
    <partial name="Components/_TableToolbar" model='new TableToolbarModel {
        TargetId = "users-table",
        Title = "Authorized Personnel Accounts",
        Count = Model.Count(),
        SearchPlaceholder = "Search name, email, or role...",
        FilterLabel = "All Roles",
        FilterOptions = new List<string> { "Admin", "DRCoordinator", "Staff" },
        RightNote = "Admin Controlled Access"
    }' />

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50/60 text-slate-500 text-[11px] uppercase tracking-wider font-bold">
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[220px]">Full Name</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[240px]">Account Email</th>
                    <th class="py-3.5 px-6 whitespace-nowrap w-40">Assigned Role</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[280px]">Permissions Scope</th>
                    <th class="py-3.5 pr-6 pl-4 text-right whitespace-nowrap w-40">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 text-sm">
                <tr data-filter-empty class="hidden">
                    <td colspan="5" class="py-12 text-center text-xs text-slate-400">
                        No matching user accounts found for the current filter.
                    </td>
                </tr>
                @foreach (var user in Model)
                {
                    var isCurrentUser = user.Email == User.Identity?.Name;
                    var permScope = user.Role switch
                    {
                        "Admin" => "Full CRUD on all modules + User & Role Management + Delete",
                        "DRCoordinator" => "Create, Read, Update plans & records (No Delete, No Users)",
                        _ => "Read-only access across all modules"
                    };

                    <tr data-filter-item
                        data-filter-value="@user.Role.ToLower()"
                        data-search-text="@($"{user.FullName} {user.Email} {user.Role} {permScope}")"
                        class="hover:bg-[#f4f6f2]/50 transition-colors group">
                        <td class="py-4 px-6 font-semibold text-slate-900 align-middle">
                            <div class="flex items-center gap-2">
                                <span>@user.FullName</span>
                                @if (isCurrentUser)
                                {
                                    <span class="text-[10px] bg-[#f4f6f2] text-[#355038] px-2 py-0.5 rounded-full border border-[#426246]/25 font-bold">
                                        You
                                    </span>
                                }
                            </div>
                        </td>

                        <td class="py-4 px-6 font-mono text-xs text-slate-600 align-middle">
                            @user.Email
                        </td>

                        <td class="py-4 px-6 whitespace-nowrap align-middle">
                            <partial name="Components/_Badge" model='new BadgeModel { Value = user.Role, Type = "role" }' />
                        </td>

                        <td class="py-4 px-6 text-xs text-slate-500 align-middle">
                            @permScope
                        </td>

                        <td class="py-4 pr-6 pl-4 text-right whitespace-nowrap align-middle">
                            <div class="inline-flex items-center justify-end gap-1.5">
                                <partial name="Components/_Button" model='new ButtonModel { Text = "Change Role", Href = Url.Action("EditRole", new { id = user.Id }), Variant = "secondary", Size = "sm" }' />
                                @if (!isCurrentUser)
                                {
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Are you sure you want to remove account @user.FullName?');" class="inline">
                                        @Html.AntiForgeryToken()
                                        <partial name="Components/_Button" model='new ButtonModel { Variant = "danger-subtle", Size = "icon", Icon = "trash-2", IsSubmit = true, Title = "Remove User" }' />
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="Components/Modals/_CreateUserModal" />
