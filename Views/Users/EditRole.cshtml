@model Green_Basket.Models.ViewModels.EditUserRoleViewModel

@{
    ViewData["Title"] = "Change User Role";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto">
    <div class="mb-6 flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Change Role</h1>
            <p class="text-sm text-slate-500 mt-1">Modify permission level for @Model.Email</p>
        </div>
        <a asp-action="Index" class="text-sm text-slate-500 hover:text-slate-800 flex items-center gap-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Back to list</span>
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-8">
        <form asp-action="EditRole" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Email" />

            <div>
                <label class="form-label">Account</label>
                <input value="@Model.Email" class="form-input bg-slate-50 text-slate-500" disabled />
            </div>

            <div>
                <label asp-for="Role" class="form-label">Assigned Role</label>
                <select asp-for="Role" class="form-select">
                    <option value="Staff">Staff (Read-Only across all modules)</option>
                    <option value="DRCoordinator">DR Coordinator (Create &amp; Edit plans, no Delete)</option>
                    <option value="Admin">Admin (Full Access &amp; User Management)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <a asp-action="Index" class="text-sm text-slate-500 hover:text-slate-800">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Save Role Change</span>
                </button>
            </div>
        </form>
    </div>
</div>
