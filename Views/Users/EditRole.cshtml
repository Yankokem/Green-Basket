@model Green_Basket.Models.ViewModels.EditUserRoleViewModel
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Change User Role";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = "User Management",
        Title = "Change User Role",
        Subtitle = $"Modify permission level for {Model.Email}",
        BackUrl = Url.Action("Index", "Users")
    }' />

    <div class="gb-card p-6 sm:p-8">
        <form asp-action="EditRole" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Email" />

            <div>
                <label class="form-label">Account</label>
                <input value="@Model.Email" class="form-input font-mono" disabled />
            </div>

            <div>
                <label asp-for="Role" class="form-label">Assigned Role</label>
                <select asp-for="Role" class="form-select">
                    <option value="Staff">Staff (Read-Only across all modules)</option>
                    <option value="DRCoordinator">DR Coordinator (Create &amp; Edit plans, no Delete)</option>
                    <option value="Admin">Admin (Full Access &amp; User Management)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-5 border-t border-slate-100">
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Save Role Change", Icon = "check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
