@model Green_Basket.Models.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create New User";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto">
    <div class="mb-6 flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Add User Account</h1>
            <p class="text-sm text-slate-500 mt-1">Provision a new hospital disaster recovery account.</p>
        </div>
        <a asp-action="Index" class="text-sm text-slate-500 hover:text-slate-800 flex items-center gap-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Back to list</span>
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 text-rose-700 text-xs"></div>

            <div>
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-input" placeholder="e.g. Marcus Vance" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Email" class="form-label">Hospital Email</label>
                <input asp-for="Email" class="form-input" placeholder="e.g. mvance@greenbasket.local" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Password" class="form-label">Temporary Password</label>
                <input asp-for="Password" class="form-input" placeholder="123" />
                <p class="text-[11px] text-slate-400 mt-1">Default set to '123'.</p>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Role" class="form-label">System Role &amp; Permission Tier</label>
                <select asp-for="Role" class="form-select">
                    <option value="Staff">Staff (Read-Only across all modules)</option>
                    <option value="DRCoordinator">DR Coordinator (Create &amp; Edit plans, no Delete)</option>
                    <option value="Admin">Admin (Full Access &amp; User Management)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm flex items-center gap-2">
                    <i data-lucide="user-check" class="w-4 h-4"></i>
                    <span>Create Account</span>
                </button>
            </div>
        </form>
    </div>
</div>
