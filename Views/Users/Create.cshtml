@model Green_Basket.Models.ViewModels.CreateUserViewModel
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Create New User";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = "User Management",
        Title = "Add User Account",
        Subtitle = "Provision a new hospital disaster recovery account.",
        BackUrl = Url.Action("Index", "Users")
    }' />

    <div class="gb-card p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs"></div>

            <div>
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-input" placeholder="e.g. Marcus Vance" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Email" class="form-label">Hospital Email</label>
                <input asp-for="Email" class="form-input" placeholder="e.g. mvance@greenbasket.local" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Password" class="form-label">Temporary Password</label>
                <input asp-for="Password" class="form-input" placeholder="123" />
                <p class="text-[11px] text-slate-400 mt-1">Default set to '123'.</p>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Role" class="form-label">System Role &amp; Permission Tier</label>
                <select asp-for="Role" class="form-select">
                    <option value="Staff">Staff (Read-Only across all modules)</option>
                    <option value="DRCoordinator">DR Coordinator (Create &amp; Edit plans, no Delete)</option>
                    <option value="Admin">Admin (Full Access &amp; User Management)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-5 border-t border-slate-100">
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Create Account", Icon = "user-check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
