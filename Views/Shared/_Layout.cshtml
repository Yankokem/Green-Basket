<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f8faf8]">
<head>
    <partial name="_ThemeHead" />
</head>
<body class="min-h-screen flex flex-col bg-[#f8faf8] text-slate-800 antialiased selection:bg-[#426246] selection:text-white">
    <!-- Top Navigation App Shell -->
    <partial name="_TopNavbar" />

    <!-- Main Content Area -->
    <main class="flex-1 py-8 px-4 sm:px-6 lg:px-10">
        <div class="max-w-[1536px] mx-auto">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 rounded-xl bg-[#f4f6f2] border border-[#426246]/25 px-4 py-3.5 flex items-center justify-between text-[#293e2c] shadow-xs">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-[#e6ede6] flex items-center justify-center shrink-0 text-[#426246]">
                            <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                        </div>
                        <span class="text-sm font-medium">@TempData["SuccessMessage"]</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="p-1 text-[#426246]/70 hover:text-[#293e2c] rounded-md transition-colors cursor-pointer">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            }

            @if (TempData["WarningMessage"] != null)
            {
                <div class="mb-6 rounded-xl bg-amber-50 border border-amber-200 px-4 py-3.5 flex items-center justify-between text-amber-900 shadow-xs">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center shrink-0 text-amber-700">
                            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                        </div>
                        <span class="text-sm font-medium">@TempData["WarningMessage"]</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="p-1 text-amber-600 hover:text-amber-900 rounded-md transition-colors cursor-pointer">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 rounded-xl bg-rose-50 border border-rose-200 px-4 py-3.5 flex items-center justify-between text-rose-800 shadow-xs">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-rose-100 flex items-center justify-center shrink-0 text-rose-600">
                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
                        </div>
                        <span class="text-sm font-medium">@TempData["ErrorMessage"]</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="p-1 text-rose-600 hover:text-rose-800 rounded-md transition-colors cursor-pointer">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Quiet Footer -->
    <footer class="border-t border-slate-200/80 bg-white py-4 mt-auto">
        <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-10 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-2">
            <div class="flex items-center gap-2.5">
                <img src="~/images/greenbasket-logo-2x2.svg" alt="GB" class="h-6 w-6 shrink-0" />
                <span class="font-semibold text-slate-700">Green Basket</span>
                <span class="text-slate-300">·</span>
                <span>Hospital Disaster Recovery Planner</span>
                <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 font-mono text-[10px] font-medium">System #37</span>
            </div>
            <div>
                Hospital IT Preparedness &amp; Continuity Platform
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        lucide.createIcons();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
