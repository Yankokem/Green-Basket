@using Microsoft.AspNetCore.Identity
@using Green_Basket.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md shadow-sm">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-10">
        <div class="flex h-20 items-center justify-between gap-6">
            
            <!-- Left: Brand & Tagline -->
            <div class="flex items-center gap-8 shrink-0">
                <a asp-controller="Assets" asp-action="Index" class="flex items-center gap-3.5 group shrink-0">
                    <div class="w-11 h-11 rounded-xl bg-emerald-600 flex items-center justify-center text-white shadow-md shadow-emerald-600/25 group-hover:scale-105 transition-all shrink-0">
                        <i data-lucide="shield-check" class="w-6 h-6"></i>
                    </div>
                    <div class="flex flex-col justify-center">
                        <div class="flex items-center gap-2">
                            <span class="text-lg font-bold text-slate-900 tracking-tight whitespace-nowrap leading-none">Green Basket</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-emerald-100 text-emerald-800 leading-none">
                                DR Planner
                            </span>
                        </div>
                        <span class="text-xs text-slate-400 font-medium whitespace-nowrap mt-1 leading-none">
                            Hospital IT Readiness System
                        </span>
                    </div>
                </a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <!-- Center: Horizontal Navigation Links (No Sidebar!) -->
                    <nav class="hidden xl:flex items-center space-x-1.5 ml-4">
                        <a asp-controller="Assets" asp-action="Index" 
                           class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-all inline-flex items-center gap-2 whitespace-nowrap @(currentController == "Assets" ? "bg-emerald-50 text-emerald-700 shadow-sm shadow-emerald-500/10 ring-1 ring-emerald-200/60" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/80")">
                            <i data-lucide="server" class="w-4 h-4 @(currentController == "Assets" ? "text-emerald-600" : "text-slate-400")"></i>
                            Assets
                        </a>

                        <a asp-controller="RecoveryProcedures" asp-action="Index" 
                           class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-all inline-flex items-center gap-2 whitespace-nowrap @(currentController == "RecoveryProcedures" ? "bg-emerald-50 text-emerald-700 shadow-sm shadow-emerald-500/10 ring-1 ring-emerald-200/60" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/80")">
                            <i data-lucide="file-text" class="w-4 h-4 @(currentController == "RecoveryProcedures" ? "text-emerald-600" : "text-slate-400")"></i>
                            Procedures
                        </a>

                        <a asp-controller="Contacts" asp-action="Index" 
                           class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-all inline-flex items-center gap-2 whitespace-nowrap @(currentController == "Contacts" ? "bg-emerald-50 text-emerald-700 shadow-sm shadow-emerald-500/10 ring-1 ring-emerald-200/60" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/80")">
                            <i data-lucide="users" class="w-4 h-4 @(currentController == "Contacts" ? "text-emerald-600" : "text-slate-400")"></i>
                            Contacts
                        </a>

                        <a asp-controller="RecoveryTests" asp-action="Index" 
                           class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-all inline-flex items-center gap-2 whitespace-nowrap @(currentController == "RecoveryTests" ? "bg-emerald-50 text-emerald-700 shadow-sm shadow-emerald-500/10 ring-1 ring-emerald-200/60" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/80")">
                            <i data-lucide="activity" class="w-4 h-4 @(currentController == "RecoveryTests" ? "text-emerald-600" : "text-slate-400")"></i>
                            Recovery Tests
                        </a>

                        <a asp-controller="RecoveryTasks" asp-action="Index" 
                           class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-all inline-flex items-center gap-2 whitespace-nowrap @(currentController == "RecoveryTasks" ? "bg-emerald-50 text-emerald-700 shadow-sm shadow-emerald-500/10 ring-1 ring-emerald-200/60" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/80")">
                            <i data-lucide="check-square" class="w-4 h-4 @(currentController == "RecoveryTasks" ? "text-emerald-600" : "text-slate-400")"></i>
                            Recovery Tasks
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Users" asp-action="Index" 
                               class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-all inline-flex items-center gap-2 whitespace-nowrap @(currentController == "Users" ? "bg-emerald-50 text-emerald-700 shadow-sm shadow-emerald-500/10 ring-1 ring-emerald-200/60" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/80")">
                                <i data-lucide="user-cog" class="w-4 h-4 @(currentController == "Users" ? "text-emerald-600" : "text-slate-400")"></i>
                                User Management
                            </a>
                        }
                    </nav>
                }
            </div>

            <!-- Right: Auth, User Profile & Actions -->
            <div class="flex items-center gap-4 shrink-0">
                @if (SignInManager.IsSignedIn(User))
                {
                    var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("DRCoordinator") ? "DR Coordinator" : "Staff";
                    var roleBadgeClass = User.IsInRole("Admin") 
                        ? "bg-purple-100 text-purple-800 border-purple-200" 
                        : User.IsInRole("DRCoordinator") 
                            ? "bg-teal-100 text-teal-800 border-teal-200" 
                            : "bg-slate-100 text-slate-700 border-slate-200";

                    var fullName = User.FindFirst("FullName")?.Value;
                    if (string.IsNullOrWhiteSpace(fullName))
                    {
                        fullName = User.Identity?.Name;
                    }

                    <div class="hidden sm:flex flex-col items-end leading-tight">
                        <span class="text-sm font-bold text-slate-900">@fullName</span>
                        <div class="flex items-center gap-1.5 mt-0.5">
                            <span class="text-[11px] text-slate-400 font-mono">@User.Identity?.Name</span>
                            <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-bold uppercase tracking-wider border @roleBadgeClass">
                                @userRole
                            </span>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" 
                                class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 border border-slate-200 rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-rose-500/20"
                                title="Sign out">
                            <i data-lucide="log-out" class="w-4 h-4 text-slate-400 group-hover:text-rose-500"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" 
                       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm shadow-emerald-600/20 transition-all">
                        <i data-lucide="log-in" class="w-4 h-4"></i>
                        <span>Login</span>
                    </a>
                }
            </div>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <!-- Secondary bar for medium screens below XL -->
            <div class="xl:hidden py-3 border-t border-slate-100 flex items-center gap-2 overflow-x-auto text-xs no-scrollbar">
                <a asp-controller="Assets" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @(currentController == "Assets" ? "bg-emerald-100 text-emerald-800" : "text-slate-600 bg-slate-50")">Assets</a>
                <a asp-controller="RecoveryProcedures" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @(currentController == "RecoveryProcedures" ? "bg-emerald-100 text-emerald-800" : "text-slate-600 bg-slate-50")">Procedures</a>
                <a asp-controller="Contacts" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @(currentController == "Contacts" ? "bg-emerald-100 text-emerald-800" : "text-slate-600 bg-slate-50")">Contacts</a>
                <a asp-controller="RecoveryTests" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @(currentController == "RecoveryTests" ? "bg-emerald-100 text-emerald-800" : "text-slate-600 bg-slate-50")">Recovery Tests</a>
                <a asp-controller="RecoveryTasks" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @(currentController == "RecoveryTasks" ? "bg-emerald-100 text-emerald-800" : "text-slate-600 bg-slate-50")">Recovery Tasks</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Users" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @(currentController == "Users" ? "bg-emerald-100 text-emerald-800" : "text-slate-600 bg-slate-50")">User Management</a>
                }
            </div>
        }
    </div>
</header>
