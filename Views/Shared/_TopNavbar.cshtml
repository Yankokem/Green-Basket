@using Microsoft.AspNetCore.Identity
@using Green_Basket.Models
@using Green_Basket.Models.ViewModels
@inject SignInManager<ApplicationUser> SignInManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string NavClass(string controller) => currentController == controller
        ? "bg-[#f4f6f2] text-[#355038] ring-1 ring-[#426246]/20 font-semibold"
        : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 font-medium";

    string IconClass(string controller) => currentController == controller
        ? "text-[#426246]"
        : "text-slate-400";

    string MobileNavClass(string controller) => currentController == controller
        ? "bg-[#426246] text-white"
        : "text-slate-600 bg-slate-100/80 hover:bg-slate-200/70";
}

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-10">
        <div class="flex h-16 items-center justify-between gap-4">

            <!-- Left: Brand + Horizontal Links -->
            <div class="flex items-center gap-6 min-w-0">
                <a asp-controller="Assets" asp-action="Index" class="flex items-center shrink-0 hover:opacity-85 transition-opacity">
                    <img src="~/images/greenbasket-logo-4x1.svg" alt="Green Basket" class="h-9 w-auto -ml-2 select-none" />
                </a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <nav class="hidden xl:flex items-center gap-1">
                        <a asp-controller="Assets" asp-action="Index"
                           class="px-3 py-1.5 rounded-lg text-sm transition-all inline-flex items-center gap-2 whitespace-nowrap @NavClass("Assets")">
                            <i data-lucide="server" class="w-4 h-4 @IconClass("Assets")"></i>
                            <span>Assets</span>
                        </a>

                        <a asp-controller="RecoveryProcedures" asp-action="Index"
                           class="px-3 py-1.5 rounded-lg text-sm transition-all inline-flex items-center gap-2 whitespace-nowrap @NavClass("RecoveryProcedures")">
                            <i data-lucide="file-text" class="w-4 h-4 @IconClass("RecoveryProcedures")"></i>
                            <span>Procedures</span>
                        </a>

                        <a asp-controller="Contacts" asp-action="Index"
                           class="px-3 py-1.5 rounded-lg text-sm transition-all inline-flex items-center gap-2 whitespace-nowrap @NavClass("Contacts")">
                            <i data-lucide="users" class="w-4 h-4 @IconClass("Contacts")"></i>
                            <span>Contacts</span>
                        </a>

                        <a asp-controller="RecoveryTests" asp-action="Index"
                           class="px-3 py-1.5 rounded-lg text-sm transition-all inline-flex items-center gap-2 whitespace-nowrap @NavClass("RecoveryTests")">
                            <i data-lucide="activity" class="w-4 h-4 @IconClass("RecoveryTests")"></i>
                            <span>Tests</span>
                        </a>

                        <a asp-controller="RecoveryTasks" asp-action="Index"
                           class="px-3 py-1.5 rounded-lg text-sm transition-all inline-flex items-center gap-2 whitespace-nowrap @NavClass("RecoveryTasks")">
                            <i data-lucide="check-square" class="w-4 h-4 @IconClass("RecoveryTasks")"></i>
                            <span>Tasks</span>
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Users" asp-action="Index"
                               class="px-3 py-1.5 rounded-lg text-sm transition-all inline-flex items-center gap-2 whitespace-nowrap @NavClass("Users")">
                                <i data-lucide="user-cog" class="w-4 h-4 @IconClass("Users")"></i>
                                <span>Users</span>
                            </a>
                        }
                    </nav>
                }
            </div>

            <!-- Right: Clean User Chip & Logout -->
            <div class="flex items-center gap-3 shrink-0">
                @if (SignInManager.IsSignedIn(User))
                {
                    var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("DRCoordinator") ? "DR Coordinator" : "Staff";
                    var fullName = User.FindFirst("FullName")?.Value;
                    if (string.IsNullOrWhiteSpace(fullName))
                    {
                        fullName = User.Identity?.Name;
                    }

                    <div class="hidden sm:flex flex-col items-end leading-tight gap-0.5">
                        <span class="text-sm font-semibold text-slate-900">@fullName</span>
                        <span class="text-xs font-medium text-slate-500">@userRole</span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <partial name="Components/_Button" model='new ButtonModel { Variant = "primary-ghost", Size = "icon", Icon = "log-out", IsSubmit = true, Title = "Sign out" }' />
                    </form>
                }
                else
                {
                    <partial name="Components/_Button" model='new ButtonModel { Text = "Sign in", Href = Url.Action("Login", "Account"), Variant = "primary", Size = "sm", Icon = "log-in" }' />
                }
            </div>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <!-- Compact Mobile/Tablet Strip -->
            <div class="xl:hidden py-2.5 border-t border-slate-100 flex items-center gap-1.5 overflow-x-auto text-xs no-scrollbar">
                <a asp-controller="Assets" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @MobileNavClass("Assets")">Assets</a>
                <a asp-controller="RecoveryProcedures" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @MobileNavClass("RecoveryProcedures")">Procedures</a>
                <a asp-controller="Contacts" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @MobileNavClass("Contacts")">Contacts</a>
                <a asp-controller="RecoveryTests" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @MobileNavClass("RecoveryTests")">Tests</a>
                <a asp-controller="RecoveryTasks" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @MobileNavClass("RecoveryTasks")">Tasks</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Users" asp-action="Index" class="px-3 py-1.5 rounded-lg font-semibold whitespace-nowrap shrink-0 @MobileNavClass("Users")">Users</a>
                }
            </div>
        }
    </div>
</header>
