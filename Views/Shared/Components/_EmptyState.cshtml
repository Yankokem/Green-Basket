@model Green_Basket.Models.ViewModels.EmptyStateModel
@using Green_Basket.Models.ViewModels

@{
    bool canShowAction = !string.IsNullOrEmpty(Model.ActionText) && (!string.IsNullOrEmpty(Model.ActionUrl) || !string.IsNullOrEmpty(Model.ActionModalTarget));
    if (canShowAction && !string.IsNullOrEmpty(Model.RequiredRole))
    {
        var allowed = Model.RequiredRole.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        canShowAction = allowed.Any(r => User.IsInRole(r));
    }
}

<div class="py-14 px-6 text-center">
    <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-slate-100 text-slate-400 mb-3">
        <i data-lucide="@Model.Icon" class="w-5 h-5"></i>
    </div>
    <p class="text-sm font-semibold text-slate-700">@Model.Title</p>
    @if (!string.IsNullOrEmpty(Model.Subtitle))
    {
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">@Model.Subtitle</p>
    }
    @if (canShowAction)
    {
        <div class="mt-4">
            <partial name="Components/_Button" model='new ButtonModel {
                Text = Model.ActionText!,
                Href = Model.ActionUrl,
                ModalTarget = Model.ActionModalTarget,
                ModalAssetId = Model.ActionModalAssetId,
                Variant = "subtle",
                Size = "sm",
                Icon = "plus"
            }' />
        </div>
    }
</div>
