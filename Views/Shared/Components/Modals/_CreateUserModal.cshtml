@using Green_Basket.Models.ViewModels

<div id="createUserModal" data-modal-root class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6">
    <div data-modal-backdrop class="fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] opacity-0 transition-opacity duration-200 ease-out"></div>
    <div data-modal-panel class="relative z-10 w-full max-w-xl max-h-[90vh] flex flex-col bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden opacity-0 scale-95 translate-y-3 transition-all duration-200 ease-out">
        <partial name="Components/Modals/_ModalHeader" model='new[] { "User Management", "Add User Account", "Provision a new hospital disaster recovery account." }' />

        <form asp-controller="Users" asp-action="Create" method="post" class="p-6 space-y-4 overflow-y-auto">
            @Html.AntiForgeryToken()

            <div>
                <label class="form-label">Full Name</label>
                <input name="FullName" required maxlength="100" class="form-input" placeholder="e.g. Marcus Vance" />
            </div>

            <div>
                <label class="form-label">Hospital Email</label>
                <input name="Email" type="email" required class="form-input" placeholder="e.g. mvance@greenbasket.local" />
            </div>

            <div>
                <label class="form-label">Temporary Password</label>
                <input name="Password" type="password" value="123" required minlength="3" class="form-input" placeholder="123" />
                <p class="text-[11px] text-slate-400 mt-1">Default set to '123'.</p>
            </div>

            <div>
                <label class="form-label">System Role &amp; Permission Tier</label>
                <select name="Role" required class="form-select">
                    <option value="Staff">Staff (Read-Only across all modules)</option>
                    <option value="DRCoordinator">DR Coordinator (Create &amp; Edit plans, no Delete)</option>
                    <option value="Admin">Admin (Full Access &amp; User Management)</option>
                </select>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100">
                <button type="button" data-modal-close class="px-4 py-2 text-sm font-medium rounded-lg border border-slate-300 text-slate-700 bg-white hover:bg-slate-50 transition-colors cursor-pointer">
                    Cancel
                </button>
                <partial name="Components/_Button" model='new ButtonModel { Text = "Create Account", Icon = "user-check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
