@using Green_Basket.Models.ViewModels

@{
    var defaultDue = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
}

<div id="createTaskModal" data-modal-root class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6">
    <div data-modal-backdrop class="fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] opacity-0 transition-opacity duration-200 ease-out"></div>
    <div data-modal-panel class="relative z-10 w-full max-w-2xl max-h-[90vh] flex flex-col bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden opacity-0 scale-95 translate-y-3 transition-all duration-200 ease-out">
        <partial name="Components/Modals/_ModalHeader" model='new[] { "Recovery Tasks", "Add Recovery Task", "Assign an IT disaster readiness or remediation action." }' />

        <form asp-controller="RecoveryTasks" asp-action="Create" method="post" class="p-6 space-y-4 overflow-y-auto">
            @Html.AntiForgeryToken()

            <div>
                <label class="form-label">Linked Hospital Asset</label>
                <select name="AssetId" required class="form-select" asp-items="ViewBag.AssetId">
                    <option value="">-- Select Target Asset --</option>
                </select>
            </div>

            <div>
                <label class="form-label">Task Description / Title</label>
                <input name="Title" required maxlength="200" class="form-input" placeholder="e.g. Rotate secondary DR admin keys, upgrade failover link" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="form-label">Assignee Name / Role</label>
                    <input name="AssignedTo" required maxlength="100" class="form-input" placeholder="e.g. James Alvarez, Cloud Engineer" />
                </div>

                <div>
                    <label class="form-label">Task Status</label>
                    <select name="Status" required class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Done">Done</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="form-label">Due Date</label>
                <input name="DueDate" type="date" value="@defaultDue" class="form-input font-mono" />
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100">
                <button type="button" data-modal-close class="px-4 py-2 text-sm font-medium rounded-lg border border-slate-300 text-slate-700 bg-white hover:bg-slate-50 transition-colors cursor-pointer">
                    Cancel
                </button>
                <partial name="Components/_Button" model='new ButtonModel { Text = "Save Task", Icon = "check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
