@model Green_Basket.Models.ViewModels.BadgeModel

@{
    var val = Model.Value?.Trim() ?? string.Empty;
    var badgeClass = "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold ring-1 ring-inset whitespace-nowrap";

    var colorClass = val.ToLower() switch
    {
        // Priority
        "critical" => "bg-rose-50 text-rose-700 ring-rose-600/20",
        "high" => "bg-amber-50 text-amber-800 ring-amber-600/20",
        "medium" => "bg-sky-50 text-sky-700 ring-sky-700/20",
        "low" => "bg-slate-100 text-slate-600 ring-slate-500/20",

        // Results & Compliance
        "passed" or "target met" or "met" or "dr ready" => "bg-[#f4f6f2] text-[#355038] ring-[#426246]/25",
        "failed" or "target exceeded" or "exceeded" or "at risk" => "bg-rose-50 text-rose-700 ring-rose-600/20",
        "untested" => "bg-slate-100 text-slate-600 ring-slate-500/20",

        // Tasks
        "pending" => "bg-slate-100 text-slate-700 ring-slate-500/20",
        "in progress" => "bg-amber-50 text-amber-800 ring-amber-600/20",
        "done" => "bg-[#f4f6f2] text-[#355038] ring-[#426246]/25",

        // Roles
        "admin" => "bg-violet-50 text-violet-700 ring-violet-600/20",
        "dr coordinator" or "drcoordinator" => "bg-[#f4f6f2] text-[#355038] ring-[#426246]/25",
        "staff" => "bg-slate-100 text-slate-600 ring-slate-500/20",

        _ => "bg-slate-100 text-slate-700 ring-slate-500/20"
    };

    var dotColor = val.ToLower() switch
    {
        "critical" or "failed" or "target exceeded" or "exceeded" or "at risk" => "bg-rose-500",
        "high" or "in progress" => "bg-amber-500",
        "medium" => "bg-sky-500",
        "passed" or "done" or "target met" or "met" or "dr ready" or "dr coordinator" or "drcoordinator" => "bg-[#426246]",
        "admin" => "bg-violet-500",
        _ => "bg-slate-400"
    };

    var displayVal = val.Equals("DRCoordinator", StringComparison.OrdinalIgnoreCase) ? "DR Coordinator" : val;
}

<span class="@badgeClass @colorClass">
    @if (Model.ShowDot)
    {
        <span class="w-1.5 h-1.5 rounded-full @dotColor shrink-0"></span>
    }
    <span>@displayVal</span>
</span>
