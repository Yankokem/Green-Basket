@model Green_Basket.Models.ViewModels.StatCardModel

@{
    var iconWrap = Model.Tone?.ToLower() switch
    {
        "rose" => "bg-rose-50 text-rose-600 border-rose-100",
        "amber" => "bg-amber-50 text-amber-600 border-amber-100",
        "blue" => "bg-sky-50 text-sky-600 border-sky-100",
        "slate" => "bg-slate-100 text-slate-600 border-slate-200",
        _ => "bg-[#f4f6f2] text-[#426246] border-[#426246]/15"
    };
}

<div class="gb-card p-5 flex items-center gap-4">
    <div class="w-11 h-11 rounded-xl flex items-center justify-center border shrink-0 @iconWrap">
        <i data-lucide="@Model.Icon" class="w-5 h-5"></i>
    </div>
    <div class="min-w-0">
        <span class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400">@Model.Label</span>
        <div class="mt-0.5 flex items-baseline gap-1.5">
            <span class="text-lg font-bold text-slate-900 truncate font-mono" title="@Model.Value">@Model.Value</span>
            @if (!string.IsNullOrEmpty(Model.Unit))
            {
                <span class="text-xs font-normal text-slate-500">@Model.Unit</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.Subtext))
        {
            <p class="text-xs text-slate-400 mt-0.5 truncate">@Model.Subtext</p>
        }
    </div>
</div>
