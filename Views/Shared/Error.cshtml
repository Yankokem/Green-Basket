@model ErrorViewModel
@{
    ViewData["Title"] = "Application Error";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-sm border border-rose-200 text-center">
    <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-4 border border-rose-100">
        <i data-lucide="alert-octagon" class="w-8 h-8"></i>
    </div>
    <h1 class="text-2xl font-bold text-slate-900 mb-2">Unexpected Application Error</h1>
    <p class="text-sm text-slate-500 mb-6">
        An error occurred while processing your request. Please check the logs or return to the dashboard.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs font-mono text-slate-600 mb-6 inline-block">
            <strong>Request ID:</strong> @Model.RequestId
        </div>
    }

    <div>
        <a asp-controller="Assets" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Return to Dashboard</span>
        </a>
    </div>
</div>
