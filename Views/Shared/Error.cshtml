@model ErrorViewModel
@using Green_Basket.Models.ViewModels
@{
    ViewData["Title"] = "Application Error";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto gb-card border-rose-200 p-8 text-center mt-8">
    <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-4 border border-rose-100">
        <i data-lucide="alert-octagon" class="w-7 h-7"></i>
    </div>
    <h1 class="text-xl font-bold text-slate-900 mb-2">Unexpected Application Error</h1>
    <p class="text-sm text-slate-500 mb-6">
        An error occurred while processing your request. Please check the logs or return to the dashboard.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs font-mono text-slate-600 mb-6 inline-block">
            <strong>Request ID:</strong> @Model.RequestId
        </div>
    }

    <div>
        <partial name="Components/_Button" model='new ButtonModel { Text = "Return to Dashboard", Href = Url.Action("Index", "Assets"), Variant = "primary", Icon = "arrow-left" }' />
    </div>
</div>
