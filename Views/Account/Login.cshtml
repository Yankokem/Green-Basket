@model Green_Basket.Models.ViewModels.LoginViewModel
@using Green_Basket.Models.ViewModels
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-white">
<head>
    <partial name="_ThemeHead" />
</head>
<body class="min-h-screen bg-white text-slate-900 antialiased selection:bg-[#426246] selection:text-white">
    <div class="min-h-screen grid grid-cols-1 lg:grid-cols-12">

        <!-- Left: Open Brand & Readiness Canvas -->
        <aside class="hidden lg:flex lg:col-span-6 xl:col-span-7 relative flex-col justify-between p-12 xl:p-16 bg-[#f4f6f2] bg-grid-subtle border-r border-[#426246]/10 overflow-hidden">
            <div class="pointer-events-none absolute -top-32 -left-32 w-[480px] h-[480px] rounded-full bg-[#426246]/[0.07] blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-40 -right-24 w-[420px] h-[420px] rounded-full bg-emerald-600/[0.06] blur-3xl"></div>

            <!-- Top Wordmark (4x1 SVG) -->
            <div class="relative z-10 flex items-center justify-between">
                <img src="~/images/greenbasket-logo-4x1.svg" alt="Green Basket" class="h-12 w-auto select-none -ml-3" />
                <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#426246]/70 font-medium">
                    System #37 · DRP
                </span>
            </div>

            <!-- Center Editorial Statement -->
            <div class="relative z-10 max-w-xl my-auto py-12">
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-[#426246] font-medium mb-4">
                    Hospital IT Continuity Portal
                </p>
                <h1 class="text-4xl xl:text-[2.75rem] font-semibold tracking-tight text-slate-900 leading-[1.14]">
                    Disaster recovery readiness, organized before crisis strikes.
                </h1>
                <p class="mt-5 text-base text-slate-600 leading-relaxed max-w-lg">
                    Centralize clinical system priorities, target recovery objectives, step-by-step restoration playbooks, and drill compliance in one calm workspace.
                </p>
            </div>

            <!-- Bottom Open Metrics Strip -->
            <div class="relative z-10 grid grid-cols-3 gap-8 pt-8 border-t border-[#426246]/15 max-w-xl">
                <div>
                    <div class="text-xs font-semibold uppercase tracking-wider text-[#426246]">Prioritization</div>
                    <div class="mt-1 text-sm text-slate-600">Tier 1–4 clinical restoration order</div>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase tracking-wider text-[#426246]">RTO &amp; RPO</div>
                    <div class="mt-1 text-sm text-slate-600">Target vs. actual drill compliance</div>
                </div>
                <div>
                    <div class="text-xs font-semibold uppercase tracking-wider text-[#426246]">Remediation</div>
                    <div class="mt-1 text-sm text-slate-600">Lessons learned &amp; corrective tasks</div>
                </div>
            </div>
        </aside>

        <!-- Right: Open, Borderless Sign-In Surface -->
        <main class="lg:col-span-6 xl:col-span-5 flex flex-col justify-center px-6 py-12 sm:px-12 lg:px-14 xl:px-20 bg-white">
            <div class="w-full max-w-[400px] mx-auto">

                <!-- Mobile Wordmark (4x1 SVG) -->
                <div class="lg:hidden mb-10">
                    <img src="~/images/greenbasket-logo-4x1.svg" alt="Green Basket" class="h-11 w-auto -ml-2.5" />
                    <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.16em] text-[#426246]/80">
                        Hospital Disaster Recovery Planner
                    </p>
                </div>

                <!-- Header -->
                <div class="mb-8">
                    <h2 class="text-2xl sm:text-[1.75rem] font-semibold tracking-tight text-slate-900">
                        Sign in
                    </h2>
                    <p class="mt-1.5 text-sm text-slate-500">
                        Enter your hospital credentials to continue.
                    </p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 p-3.5 rounded-lg bg-rose-50/90 border border-rose-200/80 text-xs text-rose-700">
                        <div asp-validation-summary="All" class="list-disc pl-4 space-y-1"></div>
                    </div>
                }

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="space-y-5">
                    <div>
                        <label asp-for="Email" class="form-label">Hospital Email</label>
                        <div class="relative">
                            <input asp-for="Email"
                                   id="emailInput"
                                   class="form-input pl-10"
                                   placeholder="admin@greenbasket.local"
                                   required
                                   autocomplete="username" />
                            <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="relative">
                            <input asp-for="Password"
                                   id="passwordInput"
                                   class="form-input pl-10 pr-10"
                                   placeholder="Enter your password"
                                   required
                                   autocomplete="current-password" />
                            <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
                            <button type="button"
                                    onclick="togglePassword()"
                                    aria-label="Toggle password visibility"
                                    class="absolute right-3 top-2.5 p-0.5 text-slate-400 hover:text-slate-700 transition-colors cursor-pointer">
                                <i id="eyeIcon" data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="flex items-center justify-between pt-0.5">
                        <label class="inline-flex items-center gap-2 cursor-pointer text-xs text-slate-600 select-none">
                            <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-[#426246] focus:ring-[#426246]/30 accent-[#426246]" />
                            <span>Keep me signed in</span>
                        </label>
                    </div>

                    <partial name="Components/_Button" model='new ButtonModel { Text = "Sign in", IconRight = "arrow-right", Variant = "primary", Size = "md", IsSubmit = true, FullWidth = true }' />
                </form>

                <!-- Subtle Open Demo Account Switcher -->
                <div class="mt-10 pt-6 border-t border-slate-200/80">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                            Quick Demo Fill
                        </span>
                        <span class="font-mono text-[11px] text-slate-400">
                            pw: 123
                        </span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button"
                                onclick="fillCreds('admin@greenbasket.local')"
                                class="flex-1 min-w-[105px] px-3 py-2 text-left rounded-lg border border-slate-200 hover:border-[#426246]/40 hover:bg-[#f4f6f2] transition-all cursor-pointer">
                            <span class="block text-xs font-semibold text-slate-800">Alexander</span>
                            <span class="block text-[10px] text-[#426246] font-medium">Admin</span>
                        </button>
                        <button type="button"
                                onclick="fillCreds('coordinator@greenbasket.local')"
                                class="flex-1 min-w-[105px] px-3 py-2 text-left rounded-lg border border-slate-200 hover:border-[#426246]/40 hover:bg-[#f4f6f2] transition-all cursor-pointer">
                            <span class="block text-xs font-semibold text-slate-800">Marcus</span>
                            <span class="block text-[10px] text-slate-500 font-medium">DR Coord</span>
                        </button>
                        <button type="button"
                                onclick="fillCreds('staff@greenbasket.local')"
                                class="flex-1 min-w-[105px] px-3 py-2 text-left rounded-lg border border-slate-200 hover:border-[#426246]/40 hover:bg-[#f4f6f2] transition-all cursor-pointer">
                            <span class="block text-xs font-semibold text-slate-800">Clara</span>
                            <span class="block text-[10px] text-slate-500 font-medium">Staff</span>
                        </button>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        lucide.createIcons();

        function fillCreds(email) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = '123';
        }

        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.setAttribute('data-lucide', 'eye-off');
            } else {
                input.type = 'password';
                icon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }
    </script>
</body>
</html>
