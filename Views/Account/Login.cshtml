@model Green_Basket.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="min-h-[75vh] flex items-center justify-center">
    <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-200">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-600 text-white shadow-lg shadow-emerald-600/30 mb-4">
                <i data-lucide="shield-check" class="w-8 h-8"></i>
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-slate-900">Green Basket</h2>
            <p class="text-sm text-slate-500 mt-1">Hospital Disaster Recovery Readiness</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-3 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-700">
                <div asp-validation-summary="All" class="list-disc pl-4 space-y-1"></div>
            </div>
        }

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="Email" class="form-label">Hospital Email</label>
                <div class="relative">
                    <input asp-for="Email" id="emailInput" class="form-input pl-10" placeholder="e.g. admin@greenbasket.local" required autocomplete="username" />
                    <i data-lucide="mail" class="w-4 h-4 text-slate-400 absolute left-3 top-3"></i>
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Password" class="form-label">Password</label>
                <div class="relative">
                    <input asp-for="Password" id="passwordInput" class="form-input pl-10" placeholder="••••••••" required autocomplete="current-password" />
                    <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute left-3 top-3"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-between text-sm">
                <label class="flex items-center gap-2 cursor-pointer text-slate-600 text-xs">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                    <span>Keep me signed in</span>
                </label>
            </div>

            <button type="submit" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm rounded-lg shadow-sm shadow-emerald-600/30 transition-all flex items-center justify-center gap-2">
                <i data-lucide="log-in" class="w-4 h-4"></i>
                <span>Sign In to Disaster Recovery</span>
            </button>
        </form>

        <!-- Quick Credentials Helper Box for Testing -->
        <div class="mt-8 pt-6 border-t border-slate-100">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2.5">Demo Accounts (Password: 123)</p>
            <div class="grid grid-cols-3 gap-2">
                <button type="button" onclick="fillCreds('admin@greenbasket.local')" class="p-2.5 text-center rounded-xl border border-purple-200 bg-purple-50 hover:bg-purple-100 transition-colors">
                    <span class="block text-xs font-bold text-purple-900 truncate">Alexander</span>
                    <span class="block text-[10px] text-purple-700 mt-0.5">Admin</span>
                </button>
                <button type="button" onclick="fillCreds('coordinator@greenbasket.local')" class="p-2.5 text-center rounded-xl border border-teal-200 bg-teal-50 hover:bg-teal-100 transition-colors">
                    <span class="block text-xs font-bold text-teal-900 truncate">Marcus</span>
                    <span class="block text-[10px] text-teal-700 mt-0.5">DR Coord</span>
                </button>
                <button type="button" onclick="fillCreds('staff@greenbasket.local')" class="p-2.5 text-center rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 transition-colors">
                    <span class="block text-xs font-bold text-slate-900 truncate">Clara</span>
                    <span class="block text-[10px] text-slate-600 mt-0.5">Staff</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function fillCreds(email) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = '123';
    }
</script>
