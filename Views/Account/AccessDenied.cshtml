@using Green_Basket.Models.ViewModels
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="min-h-[60vh] flex items-center justify-center">
    <div class="max-w-md w-full gb-card p-8 text-center">
        <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-4 border border-rose-100">
            <i data-lucide="shield-alert" class="w-7 h-7"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-900 mb-2">Access Restricted</h2>
        <p class="text-sm text-slate-500 mb-6 leading-relaxed">
            Your current user role does not have authorization to view or perform operations on this section of Green Basket.
        </p>

        <partial name="Components/_Button" model='new ButtonModel { Text = "Return to Assets Dashboard", Href = Url.Action("Index", "Assets"), Variant = "primary", Icon = "arrow-left" }' />
    </div>
</div>
