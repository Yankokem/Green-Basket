@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="min-h-[60vh] flex items-center justify-center">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-lg border border-slate-200 text-center">
        <div class="w-16 h-16 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-4 border border-rose-100">
            <i data-lucide="shield-alert" class="w-8 h-8"></i>
        </div>
        <h2 class="text-2xl font-bold text-slate-900 mb-2">Access Restricted</h2>
        <p class="text-sm text-slate-500 mb-6">
            Your current user role does not have authorization to view or perform operations on this section of Green Basket.
        </p>

        <a asp-controller="Assets" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Return to Assets Dashboard</span>
        </a>
    </div>
</div>
