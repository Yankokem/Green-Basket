@model IEnumerable<Green_Basket.Models.RecoveryTest>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Recovery Tests";
    Layout = "_Layout";
    var currentAsset = ViewBag.CurrentAsset as Green_Basket.Models.Asset;
}

<partial name="Components/_PageHeader" model='new PageHeaderModel {
    Title = currentAsset != null ? $"Tests — {currentAsset.Name}" : "Disaster Recovery Test Results",
    Subtitle = "Simulated restoration drills, target RTO/RPO compliance evaluations, and lessons learned.",
    BackUrl = currentAsset != null ? Url.Action("Index", "RecoveryTests") : null,
    ActionText = "Log Test Result",
    ActionModalTarget = "createTestModal",
    ActionModalAssetId = currentAsset?.Id,
    ActionIcon = "plus-circle",
    RequiredRole = "Admin,DRCoordinator"
}' />

<div id="tests-table" class="gb-card overflow-hidden">
    <partial name="Components/_TableToolbar" model='new TableToolbarModel {
        TargetId = "tests-table",
        Title = "Recorded Simulation Drills",
        Count = Model.Count(),
        SearchPlaceholder = "Search asset, notes, lessons learned...",
        FilterLabel = "All Results",
        FilterOptions = new List<string> { "Passed", "Failed" }
    }' />

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50/60 text-slate-500 text-[11px] uppercase tracking-wider font-bold">
                    <th class="py-3.5 px-6 whitespace-nowrap w-32">Date</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[240px]">Target Hospital System</th>
                    <th class="py-3.5 px-6 whitespace-nowrap w-32">Result</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[200px]">RTO (Actual vs Target)</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[200px]">RPO (Actual vs Target)</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[260px]">Lessons Learned</th>
                    <th class="py-3.5 pr-6 pl-4 text-right whitespace-nowrap w-32">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 text-sm">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <partial name="Components/_EmptyState" model='new EmptyStateModel {
                                Icon = "activity",
                                Title = "No recovery drill tests logged yet.",
                                Subtitle = "Log simulation drill metrics to verify RTO and RPO compliance.",
                                ActionText = "Log Test Result",
                                ActionModalTarget = "createTestModal",
                                ActionModalAssetId = currentAsset?.Id,
                                RequiredRole = "Admin,DRCoordinator"
                            }' />
                        </td>
                    </tr>
                }
                else
                {
                    <tr data-filter-empty class="hidden">
                        <td colspan="7" class="py-12 text-center text-xs text-slate-400">
                            No matching test records found for the current filter.
                        </td>
                    </tr>
                    @foreach (var item in Model)
                    {
                        var targetRto = item.Asset?.RtoMinutes ?? 0;
                        var targetRpo = item.Asset?.RpoMinutes ?? 0;
                        var isRtoMet = item.ActualRtoMinutes <= targetRto;
                        var isRpoMet = item.ActualRpoMinutes <= targetRpo;

                        <tr data-filter-item
                            data-filter-value="@item.Result.ToLower()"
                            data-search-text="@($"{item.Asset?.Name} {item.Asset?.Type} {item.Result} {item.LessonsLearned} {item.Notes} {item.TestDate:yyyy-MM-dd}")"
                            class="hover:bg-[#f4f6f2]/50 transition-colors group">
                            <td class="py-4 px-6 whitespace-nowrap text-xs font-semibold text-slate-900 font-mono align-middle">
                                @item.TestDate.ToString("yyyy-MM-dd")
                            </td>
                            <td class="py-4 px-6 align-middle">
                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@item.AssetId" class="font-semibold text-slate-900 group-hover:text-[#426246] transition-colors block text-sm leading-snug">
                                    @item.Asset?.Name
                                </a>
                                <span class="inline-block text-xs text-slate-500 mt-0.5">@item.Asset?.Type</span>
                            </td>
                            <td class="py-4 px-6 whitespace-nowrap align-middle">
                                <partial name="Components/_Badge" model='new BadgeModel { Value = item.Result, Type = "result" }' />
                            </td>
                            <td class="py-4 px-6 whitespace-nowrap align-middle">
                                <div class="flex items-center gap-1.5 font-mono text-xs">
                                    <span class="font-bold text-slate-900">@item.ActualRtoMinutes m</span>
                                    <span class="text-slate-400">/ @targetRto m</span>
                                    @if (isRtoMet)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] bg-[#f4f6f2] text-[#355038] font-semibold ring-1 ring-inset ring-[#426246]/25">Met</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] bg-rose-50 text-rose-700 font-semibold ring-1 ring-inset ring-rose-600/20">+@(item.ActualRtoMinutes - targetRto)m Over</span>
                                    }
                                </div>
                            </td>
                            <td class="py-4 px-6 whitespace-nowrap align-middle">
                                <div class="flex items-center gap-1.5 font-mono text-xs">
                                    <span class="font-bold text-slate-900">@item.ActualRpoMinutes m</span>
                                    <span class="text-slate-400">/ @targetRpo m</span>
                                    @if (isRpoMet)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] bg-[#f4f6f2] text-[#355038] font-semibold ring-1 ring-inset ring-[#426246]/25">Met</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] bg-rose-50 text-rose-700 font-semibold ring-1 ring-inset ring-rose-600/20">+@(item.ActualRpoMinutes - targetRpo)m Loss</span>
                                    }
                                </div>
                            </td>
                            <td class="py-4 px-6 text-xs text-slate-600 align-middle">
                                <span class="line-clamp-2" title="@item.LessonsLearned">
                                    @(string.IsNullOrEmpty(item.LessonsLearned) ? "—" : item.LessonsLearned)
                                </span>
                            </td>
                            <td class="py-4 pr-6 pl-4 text-right whitespace-nowrap align-middle">
                                <div class="inline-flex items-center justify-end gap-1">
                                    <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Details", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "eye", Title = "View Details", CustomClass = "hover:text-[#426246] hover:bg-[#f4f6f2]" }' />
                                    @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Delete", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "trash-2", Title = "Delete", CustomClass = "hover:text-rose-700 hover:bg-rose-50" }' />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
{
    <partial name="Components/Modals/_CreateTestModal" />
}
