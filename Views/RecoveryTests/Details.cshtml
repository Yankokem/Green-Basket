@model Green_Basket.Models.RecoveryTest
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Test Result Details";
    Layout = "_Layout";
    var targetRto = Model.Asset?.RtoMinutes ?? 0;
    var targetRpo = Model.Asset?.RpoMinutes ?? 0;
    var isRtoMet = Model.ActualRtoMinutes <= targetRto;
    var isRpoMet = Model.ActualRpoMinutes <= targetRpo;
    var isPassed = string.Equals(Model.Result, "Passed", StringComparison.OrdinalIgnoreCase) && isRtoMet && isRpoMet;
    var openTasks = Model.Asset?.OpenTaskCount ?? 0;

    var breachNotes = new List<string>();
    if (!isRtoMet) breachNotes.Add($"+{Model.ActualRtoMinutes - targetRto}m RTO");
    if (!isRpoMet) breachNotes.Add($"+{Model.ActualRpoMinutes - targetRpo}m RPO");
    var suggestedTaskTitle = breachNotes.Any()
        ? $"Remediate DR breach ({string.Join(", ", breachNotes)}) — {Model.TestDate:yyyy-MM-dd}"
        : $"Resolve failed DR drill — {Model.TestDate:yyyy-MM-dd}";
}

<div class="max-w-3xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = $"Disaster Simulation Drill · {Model.TestDate:yyyy-MM-dd}",
        Title = $"{Model.Asset?.Name}",
        BackUrl = Url.Action("Index", "RecoveryTests"),
        BadgeValue = Model.Result,
        BadgeType = "result",
        EditUrl = Url.Action("Edit", "RecoveryTests", new { id = Model.Id }),
        DeleteUrl = Url.Action("Delete", "RecoveryTests", new { id = Model.Id })
    }' />

    <!-- Outcome & Next-Step Guidance Banner -->
    @if (isPassed)
    {
        <div class="mb-6 rounded-xl bg-[#f4f6f2] border border-[#426246]/25 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-[#e6ede6] text-[#426246] flex items-center justify-center shrink-0">
                    <i data-lucide="shield-check" class="w-4 h-4"></i>
                </div>
                <div class="text-xs">
                    <p class="font-semibold text-[#293e2c]">Recovery Targets Met — Asset DR Ready</p>
                    <p class="text-[#355038]/80 mt-0.5">Actual failover time and data loss remained within hospital SLA thresholds.</p>
                </div>
            </div>
            <partial name="Components/_Button" model='new ButtonModel { Text = "View Asset Plan", Href = Url.Action("Details", "Assets", new { id = Model.AssetId }), Variant = "subtle", Size = "sm", IconRight = "arrow-right" }' />
        </div>
    }
    else
    {
        <div class="mb-6 rounded-xl bg-rose-50/90 border border-rose-200 p-5 space-y-4">
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                    <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                </div>
                <div class="text-xs text-rose-900">
                    <p class="font-semibold">
                        Failed Drill — Remediation Required
                        @if (breachNotes.Any())
                        {
                            <span class="font-mono font-bold ml-1">(@string.Join(" · ", breachNotes))</span>
                        }
                    </p>
                    <p class="text-rose-700 mt-1 leading-relaxed">
                        This asset is currently flagged <strong>At Risk</strong> (@openTasks open recovery task(s)). Resolve corrective tasks, update recovery procedures if needed, and log a re-test to restore compliance.
                    </p>
                </div>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <div class="flex flex-wrap items-center gap-2 pl-11">
                    <partial name="Components/_Button" model='new ButtonModel { Text = "Assign Remediation Task", ModalTarget = "createTaskModal", ModalAssetId = Model.AssetId, ModalTitlePrefill = suggestedTaskTitle, Variant = "danger", Size = "sm", Icon = "check-square" }' />
                    <partial name="Components/_Button" model='new ButtonModel { Text = "Review Procedures", Href = Url.Action("Index", "RecoveryProcedures", new { assetId = Model.AssetId }), Variant = "outline", Size = "sm", Icon = "file-text" }' />
                    <partial name="Components/_Button" model='new ButtonModel { Text = "Log Re-Test", ModalTarget = "createTestModal", ModalAssetId = Model.AssetId, Variant = "subtle", Size = "sm", Icon = "rotate-ccw" }' />
                </div>
            }
        </div>
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div class="gb-card p-5 @(isRtoMet ? "border-[#426246]/25 bg-[#f4f6f2]/50" : "border-rose-200 bg-rose-50/40")">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Recovery Time (RTO)</span>
                <partial name="Components/_Badge" model='new BadgeModel { Value = isRtoMet ? "Target Met" : "Target Exceeded" }' />
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold text-slate-900 font-mono">@Model.ActualRtoMinutes</span>
                <span class="text-xs text-slate-500">minutes actual</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 font-mono">
                Target allowance: <strong>@targetRto minutes</strong>
                @if (!isRtoMet)
                {
                    <span class="text-rose-700 font-semibold ml-1">(+@(Model.ActualRtoMinutes - targetRto)m over)</span>
                }
            </p>
        </div>

        <div class="gb-card p-5 @(isRpoMet ? "border-[#426246]/25 bg-[#f4f6f2]/50" : "border-rose-200 bg-rose-50/40")">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Data Loss (RPO)</span>
                <partial name="Components/_Badge" model='new BadgeModel { Value = isRpoMet ? "Target Met" : "Target Exceeded" }' />
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold text-slate-900 font-mono">@Model.ActualRpoMinutes</span>
                <span class="text-xs text-slate-500">minutes loss</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 font-mono">
                Target maximum: <strong>@targetRpo minutes</strong>
                @if (!isRpoMet)
                {
                    <span class="text-rose-700 font-semibold ml-1">(+@(Model.ActualRpoMinutes - targetRpo)m over)</span>
                }
            </p>
        </div>
    </div>

    <div class="gb-card p-6 sm:p-8 space-y-6">
        <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Test Notes &amp; Observations</h3>
            <div class="p-4 bg-slate-50 rounded-xl text-xs text-slate-700 leading-relaxed border border-slate-200/70">
                @(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)
            </div>
        </div>

        <div>
            <h3 class="text-xs font-bold text-amber-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <i data-lucide="lightbulb" class="w-4 h-4 text-amber-500"></i>
                <span>Documented Lessons Learned</span>
            </h3>
            <div class="p-4 bg-amber-50/60 rounded-xl text-xs text-slate-800 leading-relaxed border border-amber-200/80 font-medium">
                @(string.IsNullOrEmpty(Model.LessonsLearned) ? "No lessons learned captured for this test." : Model.LessonsLearned)
            </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
            <span>Asset: <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="font-semibold text-[#426246] hover:underline">@Model.Asset?.Name</a></span>
            <a asp-action="Index" asp-route-assetId="@Model.AssetId" class="text-slate-600 hover:text-[#426246] hover:underline">View all tests for this asset &rarr;</a>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
{
    <partial name="Components/Modals/_CreateTaskModal" />
    <partial name="Components/Modals/_CreateTestModal" />
}
