@model Green_Basket.Models.RecoveryTest
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Test Result Details";
    Layout = "_Layout";
    var targetRto = Model.Asset?.RtoMinutes ?? 0;
    var targetRpo = Model.Asset?.RpoMinutes ?? 0;
    var isRtoMet = Model.ActualRtoMinutes <= targetRto;
    var isRpoMet = Model.ActualRpoMinutes <= targetRpo;
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex items-center justify-between border-b border-slate-200 pb-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Disaster Simulation Drill</span>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">@Model.Asset?.Name — @Model.TestDate.ToString("MMM dd, yyyy")</h1>
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-3.5 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg shadow-sm">
                    Edit
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="px-3.5 py-1.5 text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg">
                    Delete
                </a>
            }
        </div>
    </div>

    <!-- Drill Outcome & Metrics Card -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
        <div class="flex items-center justify-between pb-6 border-b border-slate-100">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Overall Drill Outcome</span>
                <div class="mt-1">
                    <partial name="Components/_Badge" model='new BadgeModel { Value = Model.Result, Type = "result" }' />
                </div>
            </div>
            <div class="text-right">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Execution Date</span>
                <div class="text-sm font-semibold text-slate-900 mt-1 font-mono">@Model.TestDate.ToString("yyyy-MM-dd")</div>
            </div>
        </div>

        <!-- RTO / RPO Target vs Actual Visual Comparison -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- RTO Box -->
            <div class="p-5 rounded-xl border @(isRtoMet ? "bg-emerald-50/50 border-emerald-200" : "bg-rose-50/50 border-rose-200")">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Recovery Time (RTO)</span>
                    @if (isRtoMet)
                    {
                        <span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800">Target Met</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded text-xs font-bold bg-rose-100 text-rose-800">Exceeded</span>
                    }
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold text-slate-900 font-mono">@Model.ActualRtoMinutes</span>
                    <span class="text-xs text-slate-500">minutes actual</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 font-mono">
                    Target allowance: <strong>@targetRto minutes</strong>
                </div>
            </div>

            <!-- RPO Box -->
            <div class="p-5 rounded-xl border @(isRpoMet ? "bg-emerald-50/50 border-emerald-200" : "bg-rose-50/50 border-rose-200")">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Data Loss (RPO)</span>
                    @if (isRpoMet)
                    {
                        <span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800">Target Met</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded text-xs font-bold bg-rose-100 text-rose-800">Exceeded</span>
                    }
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold text-slate-900 font-mono">@Model.ActualRpoMinutes</span>
                    <span class="text-xs text-slate-500">minutes loss</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 font-mono">
                    Target maximum: <strong>@targetRpo minutes</strong>
                </div>
            </div>
        </div>

        <!-- Notes -->
        <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Test Notes &amp; Observations</h3>
            <div class="p-4 bg-slate-50 rounded-lg text-xs text-slate-700 leading-relaxed border border-slate-100">
                @(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)
            </div>
        </div>

        <!-- Lessons Learned (Key Spec Requirement) -->
        <div>
            <h3 class="text-xs font-bold text-amber-600 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <i data-lucide="lightbulb" class="w-4 h-4"></i>
                <span>Documented Lessons Learned</span>
            </h3>
            <div class="p-4 bg-amber-50/60 rounded-lg text-xs text-slate-800 leading-relaxed border border-amber-200 font-medium">
                @(string.IsNullOrEmpty(Model.LessonsLearned) ? "No lessons learned captured for this test." : Model.LessonsLearned)
            </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Asset: <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="font-medium text-emerald-700 hover:underline">@Model.Asset?.Name</a></span>
            <a asp-action="Index" asp-route-assetId="@Model.AssetId" class="text-slate-600 hover:underline">View all tests for this asset &rarr;</a>
        </div>
    </div>
</div>
