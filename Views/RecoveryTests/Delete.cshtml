@model Green_Basket.Models.RecoveryTest
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Delete Test Record";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto">
    <div class="gb-card border-rose-200 overflow-hidden">
        <partial name="Components/_DeleteBanner" model='new[] {
            "Delete Test Record",
            "Are you sure you want to delete this disaster recovery simulation test record?"
        }' />

        <div class="p-6 space-y-5">
            <div class="rounded-xl bg-slate-50 p-4 border border-slate-200/80 text-sm space-y-2.5">
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">Target Asset</span>
                    <span class="text-slate-900 font-semibold">@Model.Asset?.Name</span>
                </div>
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">Drill Date</span>
                    <span class="text-slate-900 font-mono text-xs">@Model.TestDate.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="flex justify-between items-center gap-4">
                    <span class="text-slate-500 font-medium">Result</span>
                    <partial name="Components/_Badge" model='new BadgeModel { Value = Model.Result, Type = "result" }' />
                </div>
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">Actual Recovery</span>
                    <span class="text-slate-700 font-mono text-xs">RTO: @Model.ActualRtoMinutes min · RPO: @Model.ActualRpoMinutes min</span>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Delete Record", Icon = "trash-2", Variant = "danger", IsSubmit = true }' />
            </form>
        </div>
    </div>
</div>
