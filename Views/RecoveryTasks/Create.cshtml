@model Green_Basket.Models.RecoveryTask

@{
    ViewData["Title"] = "New Recovery Task";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Add Recovery Task</h1>
            <p class="text-sm text-slate-500 mt-1">Assign an IT disaster readiness or remediation action.</p>
        </div>
        <a asp-action="Index" class="text-sm text-slate-500 hover:text-slate-800 flex items-center gap-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Back to list</span>
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 text-rose-700 text-xs"></div>

            <div>
                <label asp-for="AssetId" class="form-label">Linked Hospital Asset</label>
                <select asp-for="AssetId" class="form-select" asp-items="ViewBag.AssetId">
                    <option value="">-- Select Target Asset --</option>
                </select>
                <span asp-validation-for="AssetId" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Title" class="form-label">Task Description / Title</label>
                <input asp-for="Title" class="form-input" placeholder="e.g. Rotate secondary DR admin keys, conduct monthly SAN snapshot sync" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="AssignedTo" class="form-label">Assignee Name / Role</label>
                    <input asp-for="AssignedTo" class="form-input" placeholder="e.g. James Alvarez, Cloud Engineer" />
                    <span asp-validation-for="AssignedTo" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Status" class="form-label">Task Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Done">Done</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div>
                <label asp-for="DueDate" class="form-label">Due Date</label>
                <input asp-for="DueDate" type="date" class="form-input" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Save Task</span>
                </button>
            </div>
        </form>
    </div>
</div>
