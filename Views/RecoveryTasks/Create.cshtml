@model Green_Basket.Models.RecoveryTask
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "New Recovery Task";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = "Recovery Tasks",
        Title = "Add Recovery Task",
        Subtitle = "Assign an IT disaster readiness or remediation action.",
        BackUrl = Url.Action("Index", "RecoveryTasks")
    }' />

    <div class="gb-card p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs"></div>

            <div>
                <label asp-for="AssetId" class="form-label">Linked Hospital Asset</label>
                <select asp-for="AssetId" class="form-select" asp-items="ViewBag.AssetId">
                    <option value="">-- Select Target Asset --</option>
                </select>
                <span asp-validation-for="AssetId" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Title" class="form-label">Task Description / Title</label>
                <input asp-for="Title" class="form-input" placeholder="e.g. Rotate secondary DR admin keys, conduct monthly SAN snapshot sync" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="AssignedTo" class="form-label">Assignee Name / Role</label>
                    <input asp-for="AssignedTo" class="form-input" placeholder="e.g. James Alvarez, Cloud Engineer" />
                    <span asp-validation-for="AssignedTo" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Status" class="form-label">Task Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Done">Done</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div>
                <label asp-for="DueDate" class="form-label">Due Date</label>
                <input asp-for="DueDate" type="date" class="form-input font-mono" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-5 border-t border-slate-100">
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Save Task", Icon = "check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
