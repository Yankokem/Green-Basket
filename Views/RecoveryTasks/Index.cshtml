@model IEnumerable<Green_Basket.Models.RecoveryTask>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Recovery Tasks";
    Layout = "_Layout";
    var currentAsset = ViewBag.CurrentAsset as Green_Basket.Models.Asset;
}

<partial name="Components/_PageHeader" model='new PageHeaderModel {
    Title = currentAsset != null ? $"Tasks — {currentAsset.Name}" : "Disaster Recovery Action Items & Tasks",
    Subtitle = "Actionable preparation, configuration, and remediation tasks assigned across IT infrastructure.",
    BackUrl = currentAsset != null ? Url.Action("Index", "RecoveryTasks") : null,
    ActionText = "New Task",
    ActionModalTarget = "createTaskModal",
    ActionModalAssetId = currentAsset?.Id,
    ActionIcon = "check-square",
    RequiredRole = "Admin,DRCoordinator"
}' />

<div id="tasks-table" class="gb-card overflow-hidden">
    <partial name="Components/_TableToolbar" model='new TableToolbarModel {
        TargetId = "tasks-table",
        Title = "Action Items",
        Count = Model.Count(),
        SearchPlaceholder = "Search task, assignee, or asset...",
        FilterLabel = "All Statuses",
        FilterOptions = new List<string> { "Pending", "In Progress", "Done" }
    }' />

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50/60 text-slate-500 text-[11px] uppercase tracking-wider font-bold">
                    <th class="py-3.5 px-6 whitespace-nowrap w-36">Status</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[280px]">Task Description</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[220px]">Linked Hospital System</th>
                    <th class="py-3.5 px-6 whitespace-nowrap min-w-[180px]">Assigned Individual</th>
                    <th class="py-3.5 px-6 whitespace-nowrap w-36">Due Date</th>
                    <th class="py-3.5 pr-6 pl-4 text-right whitespace-nowrap w-32">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 text-sm">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <partial name="Components/_EmptyState" model='new EmptyStateModel {
                                Icon = "check-square",
                                Title = "No recovery tasks logged yet.",
                                Subtitle = "Assign readiness or corrective remediation action items.",
                                ActionText = "New Task",
                                ActionModalTarget = "createTaskModal",
                                ActionModalAssetId = currentAsset?.Id,
                                RequiredRole = "Admin,DRCoordinator"
                            }' />
                        </td>
                    </tr>
                }
                else
                {
                    <tr data-filter-empty class="hidden">
                        <td colspan="6" class="py-12 text-center text-xs text-slate-400">
                            No matching tasks found for the current filter.
                        </td>
                    </tr>
                    @foreach (var item in Model)
                    {
                        <tr data-filter-item
                            data-filter-value="@item.Status.ToLower()"
                            data-search-text="@($"{item.Title} {item.Asset?.Name} {item.AssignedTo} {item.Status}")"
                            class="hover:bg-[#f4f6f2]/50 transition-colors group">
                            <td class="py-4 px-6 whitespace-nowrap align-middle">
                                <partial name="Components/_Badge" model='new BadgeModel { Value = item.Status, Type = "status" }' />
                            </td>
                            <td class="py-4 px-6 align-middle font-semibold text-slate-900 group-hover:text-[#426246] transition-colors">
                                <a asp-action="Details" asp-route-id="@item.Id" class="block leading-snug">
                                    @item.Title
                                </a>
                            </td>
                            <td class="py-4 px-6 whitespace-nowrap align-middle">
                                <a asp-controller="Assets" asp-action="Details" asp-route-id="@item.AssetId" class="text-xs font-semibold text-[#426246] hover:underline">
                                    @item.Asset?.Name
                                </a>
                            </td>
                            <td class="py-4 px-6 whitespace-nowrap text-xs font-medium text-slate-600 align-middle">
                                @item.AssignedTo
                            </td>
                            <td class="py-4 px-6 whitespace-nowrap text-xs font-mono font-medium text-slate-500 align-middle">
                                @(item.DueDate.HasValue ? item.DueDate.Value.ToString("yyyy-MM-dd") : "—")
                            </td>
                            <td class="py-4 pr-6 pl-4 text-right whitespace-nowrap align-middle">
                                <div class="inline-flex items-center justify-end gap-1">
                                    <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Details", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "eye", Title = "View Details", CustomClass = "hover:text-[#426246] hover:bg-[#f4f6f2]" }' />
                                    @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Delete", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "trash-2", Title = "Delete", CustomClass = "hover:text-rose-700 hover:bg-rose-50" }' />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
{
    <partial name="Components/Modals/_CreateTaskModal" />
}
