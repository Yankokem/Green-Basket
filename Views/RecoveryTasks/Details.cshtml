@model Green_Basket.Models.RecoveryTask
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Task Details — " + Model.Title;
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = "Recovery Task",
        Title = Model.Title,
        BackUrl = Url.Action("Index", "RecoveryTasks"),
        BadgeValue = Model.Status,
        BadgeType = "status",
        EditUrl = Url.Action("Edit", "RecoveryTasks", new { id = Model.Id }),
        DeleteUrl = Url.Action("Delete", "RecoveryTasks", new { id = Model.Id })
    }' />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <partial name="Components/_StatCard" model='new StatCardModel {
            Label = "Assigned Individual",
            Value = Model.AssignedTo,
            Icon = "user",
            Tone = "sage"
        }' />
        <partial name="Components/_StatCard" model='new StatCardModel {
            Label = "Target Due Date",
            Value = Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : "None",
            Icon = "calendar",
            Tone = "slate"
        }' />
    </div>

    <div class="gb-card p-6 sm:p-8 space-y-5">
        <div class="flex items-center justify-between py-2 border-b border-slate-100 text-sm">
            <span class="text-slate-500 font-medium">Linked System</span>
            <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="text-[#426246] font-semibold hover:underline">
                @Model.Asset?.Name
            </a>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 pt-1">
            <span>Status: <strong>@Model.Status</strong></span>
            <a asp-action="Index" asp-route-assetId="@Model.AssetId" class="text-slate-600 hover:text-[#426246] hover:underline">View all tasks for this asset &rarr;</a>
        </div>
    </div>
</div>
