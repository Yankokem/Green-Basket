@model Green_Basket.Models.RecoveryTask
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Task Details — " + Model.Title;
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center justify-between border-b border-slate-200 pb-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Recovery Task</span>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">@Model.Title</h1>
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-3.5 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg shadow-sm">
                    Edit
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="px-3.5 py-1.5 text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg">
                    Delete
                </a>
            }
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Current Status</span>
            <partial name="Components/_Badge" model='new BadgeModel { Value = Model.Status, Type = "status" }' />
        </div>

        <div class="space-y-4 text-sm">
            <div class="flex justify-between py-2 border-b border-slate-50">
                <span class="text-slate-500 font-medium">Assigned Individual:</span>
                <span class="text-slate-900 font-bold">@Model.AssignedTo</span>
            </div>

            <div class="flex justify-between py-2 border-b border-slate-50">
                <span class="text-slate-500 font-medium">Linked System:</span>
                <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="text-emerald-700 font-semibold hover:underline">
                    @Model.Asset?.Name
                </a>
            </div>

            <div class="flex justify-between py-2 border-b border-slate-50">
                <span class="text-slate-500 font-medium">Target Due Date:</span>
                <span class="font-mono text-slate-700 font-medium">@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("MMM dd, yyyy") : "No due date specified")</span>
            </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Asset: @Model.Asset?.Name</span>
            <a asp-action="Index" asp-route-assetId="@Model.AssetId" class="text-slate-600 hover:underline">View all tasks for this asset &rarr;</a>
        </div>
    </div>
</div>
