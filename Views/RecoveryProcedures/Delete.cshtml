@model Green_Basket.Models.RecoveryProcedure
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Delete Procedure";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto">
    <div class="gb-card border-rose-200 overflow-hidden">
        <partial name="Components/_DeleteBanner" model='new[] {
            "Delete Recovery Procedure",
            "Are you sure you want to permanently delete this recovery procedure?"
        }' />

        <div class="p-6 space-y-5">
            <div class="rounded-xl bg-slate-50 p-4 border border-slate-200/80 text-sm space-y-2.5">
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">Procedure Title</span>
                    <span class="text-slate-900 font-semibold text-right">@Model.Title</span>
                </div>
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">Linked Asset</span>
                    <span class="text-slate-900 font-semibold">@Model.Asset?.Name</span>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Delete Procedure", Icon = "trash-2", Variant = "danger", IsSubmit = true }' />
            </form>
        </div>
    </div>
</div>
