@model Green_Basket.Models.RecoveryProcedure
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Edit Procedure";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = "Recovery Procedures",
        Title = "Edit Recovery Procedure",
        Subtitle = "Update title or step-by-step restoration commands.",
        BackUrl = Url.Action("Details", "RecoveryProcedures", new { id = Model.Id })
    }' />

    <div class="gb-card p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs"></div>

            <div>
                <label asp-for="AssetId" class="form-label">Linked Hospital Asset</label>
                <select asp-for="AssetId" class="form-select" asp-items="ViewBag.AssetId"></select>
                <span asp-validation-for="AssetId" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Title" class="form-label">Procedure Title</label>
                <input asp-for="Title" class="form-input" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Steps" class="form-label">Step-by-Step Instructions</label>
                <textarea asp-for="Steps" rows="8" class="form-textarea font-mono text-xs"></textarea>
                <span asp-validation-for="Steps" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-5 border-t border-slate-100">
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Details", new { id = Model.Id }), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Update Procedure", Icon = "check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
