@model IEnumerable<Green_Basket.Models.RecoveryProcedure>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Recovery Procedures";
    Layout = "_Layout";
    var currentAsset = ViewBag.CurrentAsset as Green_Basket.Models.Asset;
}

<partial name="Components/_PageHeader" model='new PageHeaderModel { 
    Title = currentAsset != null ? $"Procedures — {currentAsset.Name}" : "System Recovery Procedures", 
    Subtitle = "Documented technical step-by-step instructions for IT system failovers, backups, and restorations.",
    ActionText = "New Procedure",
    ActionUrl = currentAsset != null ? Url.Action("Create", "RecoveryProcedures", new { assetId = currentAsset.Id }) : Url.Action("Create", "RecoveryProcedures"),
    ActionIcon = "plus",
    RequiredRole = "Admin,DRCoordinator"
}' />

@if (currentAsset != null)
{
    <div class="mb-4">
        <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-emerald-700 transition-colors">
            <i data-lucide="filter-x" class="w-3.5 h-3.5"></i>
            <span>Showing filtered asset: <strong>@currentAsset.Name</strong> (Click to view all)</span>
        </a>
    </div>
}

<div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/60">
        <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-600">
                Documented Procedures
            </span>
            <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-xs font-bold bg-slate-200/70 text-slate-700">
                @Model.Count()
            </span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="py-16 text-center text-slate-400 text-sm">
            <div class="flex flex-col items-center justify-center gap-2">
                <i data-lucide="file-text" class="w-10 h-10 text-slate-300 stroke-[1.5]"></i>
                <p class="text-sm font-medium text-slate-500">No recovery procedures documented yet.</p>
                <p class="text-xs text-slate-400">Click "New Procedure" above to author restoration instructions.</p>
            </div>
        </div>
    }
    else
    {
        <div class="divide-y divide-slate-100">
            @foreach (var proc in Model)
            {
                <div class="p-6 hover:bg-slate-50/70 transition-colors group">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200/60 shrink-0">
                                @proc.Asset?.Name
                            </span>
                            <h3 class="font-bold text-slate-900 text-base group-hover:text-emerald-700 transition-colors">@proc.Title</h3>
                        </div>

                        <div class="flex items-center gap-2 text-xs shrink-0">
                            <a asp-action="Details" asp-route-id="@proc.Id" class="px-3 py-1.5 text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg font-medium transition-colors">
                                View Steps
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                            {
                                <a asp-action="Edit" asp-route-id="@proc.Id" class="px-3 py-1.5 text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-lg font-medium transition-colors">
                                    Edit
                                </a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@proc.Id" class="px-3 py-1.5 text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg font-medium transition-colors">
                                    Delete
                                </a>
                            }
                        </div>
                    </div>

                    <div class="mt-3.5 p-4 bg-slate-50 rounded-xl text-slate-700 text-xs font-mono whitespace-pre-line leading-relaxed border border-slate-200/70 shadow-xs">
                        @proc.Steps
                    </div>
                </div>
            }
        </div>
    }
</div>
