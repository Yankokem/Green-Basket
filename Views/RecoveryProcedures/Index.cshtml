@model IEnumerable<Green_Basket.Models.RecoveryProcedure>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Recovery Procedures";
    Layout = "_Layout";
    var currentAsset = ViewBag.CurrentAsset as Green_Basket.Models.Asset;
    var assetOptions = Model.Select(p => p.Asset?.Name).Where(n => !string.IsNullOrEmpty(n)).Select(n => n!).Distinct().OrderBy(n => n).ToList();
}

<partial name="Components/_PageHeader" model='new PageHeaderModel {
    Title = currentAsset != null ? $"Procedures — {currentAsset.Name}" : "System Recovery Procedures",
    Subtitle = "Documented technical step-by-step instructions for IT system failovers, backups, and restorations.",
    BackUrl = currentAsset != null ? Url.Action("Index", "RecoveryProcedures") : null,
    ActionText = "New Procedure",
    ActionModalTarget = "createProcedureModal",
    ActionModalAssetId = currentAsset?.Id,
    ActionIcon = "plus",
    RequiredRole = "Admin,DRCoordinator"
}' />

<div id="procedures-list" class="gb-card overflow-hidden">
    <partial name="Components/_TableToolbar" model='new TableToolbarModel {
        TargetId = "procedures-list",
        Title = "Documented Procedures",
        Count = Model.Count(),
        SearchPlaceholder = "Search title, steps, or asset...",
        FilterLabel = "All Assets",
        FilterOptions = assetOptions
    }' />

    @if (!Model.Any())
    {
        <partial name="Components/_EmptyState" model='new EmptyStateModel {
            Icon = "file-text",
            Title = "No recovery procedures documented yet.",
            Subtitle = "Author step-by-step restoration instructions for critical systems.",
            ActionText = "New Procedure",
            ActionModalTarget = "createProcedureModal",
            ActionModalAssetId = currentAsset?.Id,
            RequiredRole = "Admin,DRCoordinator"
        }' />
    }
    else
    {
        <div data-filter-empty class="hidden py-12 text-center text-xs text-slate-400">
            No matching procedures found for the current filter.
        </div>
        <div class="divide-y divide-slate-100">
            @foreach (var proc in Model)
            {
                <div data-filter-item
                     data-filter-value="@(proc.Asset?.Name?.ToLower() ?? "")"
                     data-search-text="@($"{proc.Title} {proc.Asset?.Name} {proc.Steps}")"
                     class="p-6 hover:bg-[#f4f6f2]/40 transition-colors group">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div class="flex flex-wrap items-center gap-2.5 min-w-0">
                            <span class="px-2.5 py-0.5 rounded-md text-xs font-semibold bg-[#f4f6f2] text-[#355038] border border-[#426246]/20 shrink-0">
                                @proc.Asset?.Name
                            </span>
                            <a asp-action="Details" asp-route-id="@proc.Id" class="font-semibold text-slate-900 text-base group-hover:text-[#426246] transition-colors">
                                @proc.Title
                            </a>
                        </div>

                        <div class="flex items-center gap-1.5 shrink-0">
                            <partial name="Components/_Button" model='new ButtonModel { Text = "View Steps", Href = Url.Action("Details", new { id = proc.Id }), Variant = "secondary", Size = "sm" }' />
                            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                            {
                                <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", new { id = proc.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Delete", new { id = proc.Id }), Variant = "ghost", Size = "icon", Icon = "trash-2", Title = "Delete", CustomClass = "hover:text-rose-700 hover:bg-rose-50" }' />
                            }
                        </div>
                    </div>

                    <div class="mt-3.5 p-4 bg-slate-50 rounded-xl text-slate-700 text-xs font-mono whitespace-pre-line leading-relaxed border border-slate-200/70">
                        @proc.Steps
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
{
    <partial name="Components/Modals/_CreateProcedureModal" />
}
