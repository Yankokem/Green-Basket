@model Green_Basket.Models.RecoveryProcedure
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Procedure — " + Model.Title;
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = $"Asset: {Model.Asset?.Name}",
        Title = Model.Title,
        BackUrl = Url.Action("Index", "RecoveryProcedures"),
        EditUrl = Url.Action("Edit", "RecoveryProcedures", new { id = Model.Id }),
        DeleteUrl = Url.Action("Delete", "RecoveryProcedures", new { id = Model.Id })
    }' />

    <div class="gb-card p-6 sm:p-8 space-y-6">
        <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Step-by-Step Restoration Protocol</h3>
            <div class="p-5 bg-slate-50 rounded-xl border border-slate-200/80 text-sm font-mono text-slate-800 whitespace-pre-line leading-relaxed">
                @Model.Steps
            </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
            <span>Linked Asset: <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="font-semibold text-[#426246] hover:underline">@Model.Asset?.Name</a></span>
            <a asp-action="Index" asp-route-assetId="@Model.AssetId" class="text-slate-600 hover:text-[#426246] hover:underline">View all procedures for this asset &rarr;</a>
        </div>
    </div>
</div>
