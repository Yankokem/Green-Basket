@model Green_Basket.Models.RecoveryProcedure

@{
    ViewData["Title"] = "Procedure — " + Model.Title;
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between border-b border-slate-200 pb-4">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Asset: @Model.Asset?.Name</span>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">@Model.Title</h1>
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-3.5 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg shadow-sm">
                    Edit
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="px-3.5 py-1.5 text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg">
                    Delete
                </a>
            }
        </div>
    </div>

    <!-- Procedure Steps Card -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
        <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Step-by-Step Restoration Protocol</h3>
            <div class="p-5 bg-slate-50 rounded-xl border border-slate-200 text-sm font-mono text-slate-800 whitespace-pre-line leading-relaxed">
                @Model.Steps
            </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>Linked to: <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="font-medium text-emerald-700 hover:underline">@Model.Asset?.Name</a></span>
            <a asp-action="Index" asp-route-assetId="@Model.AssetId" class="text-slate-600 hover:underline">View all procedures for this asset &rarr;</a>
        </div>
    </div>
</div>
