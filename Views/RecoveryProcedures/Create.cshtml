@model Green_Basket.Models.RecoveryProcedure
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "New Recovery Procedure";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = "Recovery Procedures",
        Title = "Add Recovery Procedure",
        Subtitle = "Specify technical recovery actions linked to a hospital asset.",
        BackUrl = Url.Action("Index", "RecoveryProcedures")
    }' />

    <div class="gb-card p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs"></div>

            <div>
                <label asp-for="AssetId" class="form-label">Linked Hospital Asset</label>
                <select asp-for="AssetId" class="form-select" asp-items="ViewBag.AssetId">
                    <option value="">-- Select Target Asset --</option>
                </select>
                <span asp-validation-for="AssetId" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Title" class="form-label">Procedure Title</label>
                <input asp-for="Title" class="form-input" placeholder="e.g. Failover to Warm Standby Server, Cold Restore from Tape" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Steps" class="form-label">Step-by-Step Instructions</label>
                <textarea asp-for="Steps" rows="8" class="form-textarea font-mono text-xs" placeholder="1. Sever infected network segment.&#10;2. Verify secondary vault integrity.&#10;3. Trigger VM clone sequence.&#10;4. Re-route DNS records."></textarea>
                <p class="text-[11px] text-slate-400 mt-1">Enter numbered instructions, command-lines, or verification steps.</p>
                <span asp-validation-for="Steps" class="text-danger"></span>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-5 border-t border-slate-100">
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Save Procedure", Icon = "check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
