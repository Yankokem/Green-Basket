@model Green_Basket.Models.Contact
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Edit Contact";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto">
    <partial name="Components/_PageHeader" model='new PageHeaderModel {
        Eyebrow = "Emergency Contacts",
        Title = "Edit Contact",
        Subtitle = "Update contact credentials, phone, or email.",
        BackUrl = Url.Action("Index", "Contacts")
    }' />

    <div class="gb-card p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs"></div>

            <div>
                <label asp-for="AssetId" class="form-label">Linked Hospital Asset</label>
                <select asp-for="AssetId" class="form-select" asp-items="ViewBag.AssetId"></select>
                <span asp-validation-for="AssetId" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Name" class="form-label">Full Name</label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Role" class="form-label">Role / Responsibility</label>
                <input asp-for="Role" class="form-input" />
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Phone" class="form-label">Emergency Phone</label>
                    <input asp-for="Phone" class="form-input font-mono" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-input" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-5 border-t border-slate-100">
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Update Contact", Icon = "check", Variant = "primary", IsSubmit = true }' />
            </div>
        </form>
    </div>
</div>
