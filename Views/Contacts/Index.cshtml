@model IEnumerable<Green_Basket.Models.Contact>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Emergency Contacts";
    Layout = "_Layout";
    var currentAsset = ViewBag.CurrentAsset as Green_Basket.Models.Asset;
    var assetOptions = Model.Select(c => c.Asset?.Name).Where(n => !string.IsNullOrEmpty(n)).Select(n => n!).Distinct().OrderBy(n => n).ToList();
}

<partial name="Components/_PageHeader" model='new PageHeaderModel {
    Title = currentAsset != null ? $"Contacts — {currentAsset.Name}" : "Disaster Recovery Emergency Contacts",
    Subtitle = "System custodians, database administrators, and vendor support personnel.",
    BackUrl = currentAsset != null ? Url.Action("Index", "Contacts") : null,
    ActionText = "New Contact",
    ActionModalTarget = "createContactModal",
    ActionModalAssetId = currentAsset?.Id,
    ActionIcon = "user-plus",
    RequiredRole = "Admin,DRCoordinator"
}' />

<div id="contacts-list" class="gb-card overflow-hidden">
    <partial name="Components/_TableToolbar" model='new TableToolbarModel {
        TargetId = "contacts-list",
        Title = "Directory Contacts",
        Count = Model.Count(),
        SearchPlaceholder = "Search name, role, phone, email...",
        FilterLabel = "All Assets",
        FilterOptions = assetOptions
    }' />

    @if (!Model.Any())
    {
        <partial name="Components/_EmptyState" model='new EmptyStateModel {
            Icon = "users",
            Title = "No emergency contacts listed yet.",
            Subtitle = "Add system custodians or vendor technical leads for incident escalation.",
            ActionText = "New Contact",
            ActionModalTarget = "createContactModal",
            ActionModalAssetId = currentAsset?.Id,
            RequiredRole = "Admin,DRCoordinator"
        }' />
    }
    else
    {
        <div data-filter-empty class="hidden py-12 text-center text-xs text-slate-400">
            No matching contacts found for the current filter.
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 p-6">
            @foreach (var c in Model)
            {
                <div data-filter-item
                     data-filter-value="@(c.Asset?.Name?.ToLower() ?? "")"
                     data-search-text="@($"{c.Name} {c.Role} {c.Email} {c.Phone} {c.Asset?.Name}")"
                     class="rounded-xl border border-slate-200/90 bg-slate-50/40 hover:bg-white hover:border-[#426246]/30 p-5 flex flex-col justify-between transition-all group">
                    <div>
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <span class="inline-block text-[11px] font-semibold text-[#355038] bg-[#f4f6f2] px-2.5 py-0.5 rounded-md border border-[#426246]/20 mb-2.5">
                                    @c.Asset?.Name
                                </span>
                                <h3 class="font-semibold text-slate-900 text-base group-hover:text-[#426246] transition-colors truncate">@c.Name</h3>
                                <p class="text-xs text-slate-500 font-medium mt-0.5">@c.Role</p>
                            </div>

                            <div class="flex items-center gap-0.5 shrink-0">
                                @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                {
                                    <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", new { id = c.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit Contact", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Delete", new { id = c.Id }), Variant = "ghost", Size = "icon", Icon = "trash-2", Title = "Delete Contact", CustomClass = "hover:text-rose-700 hover:bg-rose-50" }' />
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-600">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 text-slate-500">
                                <i data-lucide="phone" class="w-3.5 h-3.5"></i>
                            </div>
                            <a href="tel:@c.Phone" class="hover:text-[#426246] font-mono font-medium">@c.Phone</a>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 text-slate-500">
                                <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                            </div>
                            <a href="mailto:@c.Email" class="hover:text-[#426246] truncate">@c.Email</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
{
    <partial name="Components/Modals/_CreateContactModal" />
}
