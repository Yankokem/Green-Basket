@model IEnumerable<Green_Basket.Models.Contact>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Emergency Contacts";
    Layout = "_Layout";
    var currentAsset = ViewBag.CurrentAsset as Green_Basket.Models.Asset;
}

<partial name="Components/_PageHeader" model='new PageHeaderModel { 
    Title = currentAsset != null ? $"Contacts — {currentAsset.Name}" : "Disaster Recovery Emergency Contacts", 
    Subtitle = "System custodians, database administrators, and vendor support personnel.",
    ActionText = "New Contact",
    ActionUrl = currentAsset != null ? Url.Action("Create", "Contacts", new { assetId = currentAsset.Id }) : Url.Action("Create", "Contacts"),
    ActionIcon = "user-plus",
    RequiredRole = "Admin,DRCoordinator"
}' />

@if (currentAsset != null)
{
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-emerald-700 transition-colors">
            <i data-lucide="filter-x" class="w-3.5 h-3.5"></i>
            <span>Filtered by asset: <strong>@currentAsset.Name</strong> (Click to view all)</span>
        </a>
    </div>
}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @if (!Model.Any())
    {
        <div class="col-span-full bg-white rounded-2xl p-16 text-center text-slate-400 border border-slate-200/80 shadow-sm">
            <i data-lucide="users" class="w-10 h-10 mx-auto text-slate-300 mb-2 stroke-[1.5]"></i>
            <p class="text-sm font-medium text-slate-500">No emergency contacts listed yet.</p>
            <p class="text-xs text-slate-400">Click "New Contact" to add emergency personnel.</p>
        </div>
    }
    @foreach (var c in Model)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 flex flex-col justify-between hover:shadow-md hover:border-slate-300/80 transition-all group">
            <div>
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <span class="inline-block text-[11px] font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200/60 mb-2.5">
                            @c.Asset?.Name
                        </span>
                        <h3 class="font-bold text-slate-900 text-lg group-hover:text-emerald-700 transition-colors">@c.Name</h3>
                        <p class="text-xs text-slate-500 font-semibold mt-0.5">@c.Role</p>
                    </div>

                    <div class="flex items-center gap-1 shrink-0">
                        @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                        {
                            <a asp-action="Edit" asp-route-id="@c.Id" class="p-1.5 text-slate-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors" title="Edit Contact">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@c.Id" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Delete Contact">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 space-y-2.5 text-xs text-slate-600">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 text-slate-500">
                        <i data-lucide="phone" class="w-3.5 h-3.5"></i>
                    </div>
                    <a href="tel:@c.Phone" class="hover:text-emerald-600 font-mono font-semibold">@c.Phone</a>
                </div>
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 text-slate-500">
                        <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                    </div>
                    <a href="mailto:@c.Email" class="hover:text-emerald-600 truncate font-medium">@c.Email</a>
                </div>
            </div>
        </div>
    }
</div>
