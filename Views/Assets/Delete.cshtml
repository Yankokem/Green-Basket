@model Green_Basket.Models.Asset
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Delete Asset — " + Model.Name;
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto">
    <div class="gb-card border-rose-200 overflow-hidden">
        <partial name="Components/_DeleteBanner" model='new[] {
            "Confirm Asset Deletion",
            "Are you sure you want to permanently delete this system? Deleting this asset will cascade and remove all linked recovery procedures, emergency contacts, drill test results, and tasks."
        }' />

        <div class="p-6 space-y-5">
            <div class="rounded-xl bg-slate-50 p-4 border border-slate-200/80 text-sm space-y-2.5">
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">Asset Name</span>
                    <span class="text-slate-900 font-semibold text-right">@Model.Name</span>
                </div>
                <div class="flex justify-between items-center gap-4">
                    <span class="text-slate-500 font-medium">Priority</span>
                    <partial name="Components/_Badge" model='new BadgeModel { Value = Model.Priority, Type = "priority" }' />
                </div>
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">System Lead</span>
                    <span class="text-slate-700">@Model.Owner</span>
                </div>
                <div class="flex justify-between gap-4">
                    <span class="text-slate-500 font-medium">Targets</span>
                    <span class="font-mono text-slate-700 text-xs">RTO: @Model.RtoMinutes min · RPO: @Model.RpoMinutes min</span>
                </div>
                <div class="flex justify-between gap-4 pt-2.5 border-t border-slate-200 text-xs text-slate-500">
                    <span>Associated Records</span>
                    <span class="font-mono">@Model.RecoveryProcedures.Count Procedures · @Model.Contacts.Count Contacts · @Model.RecoveryTests.Count Tests · @Model.RecoveryTasks.Count Tasks</span>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Cancel", Href = Url.Action("Index"), Variant = "outline" }' />
                <partial name="Components/_Button" model='new ButtonModel { Text = "Permanently Delete", Icon = "trash-2", Variant = "danger", IsSubmit = true }' />
            </form>
        </div>
    </div>
</div>
