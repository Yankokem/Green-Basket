@model Green_Basket.Models.Asset
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = Model.Name + " — Recovery Plan";
    Layout = "_Layout";
    var latestTest = Model.LatestTest;
    var readiness = Model.ReadinessStatus;
    var openTasks = Model.OpenTaskCount;
}

<partial name="Components/_PageHeader" model='new PageHeaderModel {
    Eyebrow = $"Hospital Asset Recovery Plan · {readiness}",
    Title = Model.Name,
    Subtitle = $"{Model.Type} — Managed by {Model.Owner}",
    BackUrl = Url.Action("Index", "Assets"),
    BadgeValue = readiness,
    BadgeType = "status",
    EditUrl = Url.Action("Edit", "Assets", new { id = Model.Id }),
    DeleteUrl = Url.Action("Delete", "Assets", new { id = Model.Id })
}' />

@if (readiness == "At Risk" && latestTest != null)
{
    var rtoOver = latestTest.ActualRtoMinutes > Model.RtoMinutes ? $"+{latestTest.ActualRtoMinutes - Model.RtoMinutes}m RTO" : null;
    var rpoOver = latestTest.ActualRpoMinutes > Model.RpoMinutes ? $"+{latestTest.ActualRpoMinutes - Model.RpoMinutes}m RPO" : null;
    var breachText = string.Join(" · ", new[] { rtoOver, rpoOver }.Where(x => x != null));

    <div class="mb-6 rounded-xl bg-rose-50/90 border border-rose-200 p-4 sm:p-5 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            </div>
            <div class="text-xs text-rose-900">
                <p class="font-semibold">
                    Asset At Risk — Latest Drill Failed (@latestTest.TestDate.ToString("yyyy-MM-dd"))
                    @if (!string.IsNullOrEmpty(breachText))
                    {
                        <span class="font-mono font-bold ml-1">[@breachText]</span>
                    }
                </p>
                <p class="text-rose-700 mt-1">
                    @if (openTasks > 0)
                    {
                        <span>@openTasks open recovery task(s) must be completed, then log a re-test to restore DR Ready status.</span>
                    }
                    else
                    {
                        <span>All remediation tasks are Done — this asset is ready for a verification re-test.</span>
                    }
                </p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
            <partial name="Components/_Button" model='new ButtonModel { Text = "View Failed Test", Href = Url.Action("Details", "RecoveryTests", new { id = latestTest.Id }), Variant = "outline", Size = "sm", Icon = "activity" }' />
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <partial name="Components/_Button" model='new ButtonModel { Text = "Log Re-Test", ModalTarget = "createTestModal", ModalAssetId = Model.Id, Variant = "primary", Size = "sm", Icon = "rotate-ccw" }' />
            }
        </div>
    </div>
}

<!-- Asset Targets Overview Strip -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-7">
    <partial name="Components/_StatCard" model='new StatCardModel {
        Label = "Restore Priority",
        Value = Model.Priority,
        Subtext = "Criticality tier",
        Icon = "shield",
        Tone = Model.Priority == "Critical" ? "rose" : Model.Priority == "High" ? "amber" : "blue"
    }' />
    <partial name="Components/_StatCard" model='new StatCardModel {
        Label = "RTO Target",
        Value = Model.RtoMinutes.ToString(),
        Unit = "min",
        Subtext = "Max permissible downtime",
        Icon = "clock",
        Tone = "sage"
    }' />
    <partial name="Components/_StatCard" model='new StatCardModel {
        Label = "RPO Target",
        Value = Model.RpoMinutes.ToString(),
        Unit = "min",
        Subtext = "Max acceptable data loss",
        Icon = "database",
        Tone = "blue"
    }' />
    <partial name="Components/_StatCard" model='new StatCardModel {
        Label = "Backup Dependency",
        Value = Model.BackupDependency,
        Subtext = "Primary source needed for recovery",
        Icon = "hard-drive",
        Tone = "slate"
    }' />
</div>

<!-- Tabbed Recovery Plan Workspace -->
<div data-tab-group class="gb-card overflow-hidden">
    <!-- Tab Navigation Bar -->
    <div class="border-b border-slate-200 bg-slate-50/70 px-4 sm:px-6 flex items-center gap-1 overflow-x-auto no-scrollbar">
        <button type="button" data-tab-btn="procedures"
                class="px-4 py-3.5 text-xs font-semibold border-b-2 transition-all inline-flex items-center gap-2 whitespace-nowrap cursor-pointer">
            <i data-lucide="file-text" class="w-4 h-4"></i>
            <span>Procedures</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200/80 text-slate-700">@Model.RecoveryProcedures.Count</span>
        </button>

        <button type="button" data-tab-btn="contacts"
                class="px-4 py-3.5 text-xs font-semibold border-b-2 transition-all inline-flex items-center gap-2 whitespace-nowrap cursor-pointer">
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>Emergency Contacts</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200/80 text-slate-700">@Model.Contacts.Count</span>
        </button>

        <button type="button" data-tab-btn="tests"
                class="px-4 py-3.5 text-xs font-semibold border-b-2 transition-all inline-flex items-center gap-2 whitespace-nowrap cursor-pointer">
            <i data-lucide="activity" class="w-4 h-4"></i>
            <span>Recovery Tests</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200/80 text-slate-700">@Model.RecoveryTests.Count</span>
        </button>

        <button type="button" data-tab-btn="tasks"
                class="px-4 py-3.5 text-xs font-semibold border-b-2 transition-all inline-flex items-center gap-2 whitespace-nowrap cursor-pointer">
            <i data-lucide="check-square" class="w-4 h-4"></i>
            <span>Recovery Tasks</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200/80 text-slate-700">@Model.RecoveryTasks.Count</span>
        </button>
    </div>

    <!-- Tab 1: Procedures -->
    <div data-tab-panel="procedures">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Restoration Procedures</h3>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <partial name="Components/_Button" model='new ButtonModel { Text = "Add Procedure", ModalTarget = "createProcedureModal", ModalAssetId = Model.Id, Variant = "subtle", Size = "sm", Icon = "plus" }' />
            }
        </div>
        @if (!Model.RecoveryProcedures.Any())
        {
            <partial name="Components/_EmptyState" model='new EmptyStateModel {
                Icon = "file-text",
                Title = "No recovery procedures documented.",
                Subtitle = "Add step-by-step restoration playbooks for this clinical system.",
                ActionText = "Add Procedure",
                ActionModalTarget = "createProcedureModal",
                ActionModalAssetId = Model.Id,
                RequiredRole = "Admin,DRCoordinator"
            }' />
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var proc in Model.RecoveryProcedures)
                {
                    <div class="p-6 hover:bg-slate-50/50 transition-colors">
                        <div class="flex items-start justify-between gap-4">
                            <h4 class="font-semibold text-slate-900 text-base">@proc.Title</h4>
                            <div class="flex items-center gap-1 shrink-0">
                                <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Details", "RecoveryProcedures", new { id = proc.Id }), Variant = "ghost", Size = "icon", Icon = "eye", Title = "View" }' />
                                @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                {
                                    <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", "RecoveryProcedures", new { id = proc.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Delete", "RecoveryProcedures", new { id = proc.Id }), Variant = "ghost", Size = "icon", Icon = "trash-2", Title = "Delete", CustomClass = "hover:text-rose-700 hover:bg-rose-50" }' />
                                }
                            </div>
                        </div>
                        <div class="mt-3 p-4 bg-slate-50 rounded-xl text-slate-700 text-xs font-mono whitespace-pre-line leading-relaxed border border-slate-200/60">
                            @proc.Steps
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Tab 2: Contacts -->
    <div data-tab-panel="contacts" class="hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Key Recovery Contacts</h3>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <partial name="Components/_Button" model='new ButtonModel { Text = "Add Contact", ModalTarget = "createContactModal", ModalAssetId = Model.Id, Variant = "subtle", Size = "sm", Icon = "user-plus" }' />
            }
        </div>
        @if (!Model.Contacts.Any())
        {
            <partial name="Components/_EmptyState" model='new EmptyStateModel {
                Icon = "users",
                Title = "No emergency contacts linked.",
                Subtitle = "Assign custodians, DBAs, or vendor support contacts for this asset.",
                ActionText = "Add Contact",
                ActionModalTarget = "createContactModal",
                ActionModalAssetId = Model.Id,
                RequiredRole = "Admin,DRCoordinator"
            }' />
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-6">
                @foreach (var c in Model.Contacts)
                {
                    <div class="p-4 rounded-xl border border-slate-200/90 bg-slate-50/40 hover:bg-white transition-all flex flex-col justify-between">
                        <div>
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h4 class="font-semibold text-slate-900 text-sm">@c.Name</h4>
                                    <p class="text-xs text-slate-500 mt-0.5">@c.Role</p>
                                </div>
                                <div class="flex items-center gap-0.5">
                                    @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", "Contacts", new { id = c.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit" }' />
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Delete", "Contacts", new { id = c.Id }), Variant = "ghost", Size = "icon", Icon = "trash-2", Title = "Delete", CustomClass = "hover:text-rose-700 hover:bg-rose-50" }' />
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 text-xs space-y-1.5 text-slate-600">
                            <div class="flex items-center gap-2">
                                <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400"></i>
                                <a href="tel:@c.Phone" class="hover:text-[#426246] font-mono">@c.Phone</a>
                            </div>
                            <div class="flex items-center gap-2">
                                <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400"></i>
                                <a href="mailto:@c.Email" class="hover:text-[#426246] truncate">@c.Email</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Tab 3: Recovery Tests -->
    <div data-tab-panel="tests" class="hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Simulation Drills &amp; RTO/RPO Tracking</h3>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <partial name="Components/_Button" model='new ButtonModel { Text = "Log Test Result", ModalTarget = "createTestModal", ModalAssetId = Model.Id, Variant = "subtle", Size = "sm", Icon = "plus" }' />
            }
        </div>
        @if (!Model.RecoveryTests.Any())
        {
            <partial name="Components/_EmptyState" model='new EmptyStateModel {
                Icon = "activity",
                Title = "No recovery drill tests logged yet.",
                Subtitle = "Record a failover simulation to validate actual RTO and RPO performance.",
                ActionText = "Log Test Result",
                ActionModalTarget = "createTestModal",
                ActionModalAssetId = Model.Id,
                RequiredRole = "Admin,DRCoordinator"
            }' />
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50/60 text-slate-500 text-[11px] uppercase tracking-wider font-bold">
                            <th class="py-3.5 px-6">Test Date</th>
                            <th class="py-3.5 px-6">Result</th>
                            <th class="py-3.5 px-6">RTO (Target @Model.RtoMinutes m)</th>
                            <th class="py-3.5 px-6">RPO (Target @Model.RpoMinutes m)</th>
                            <th class="py-3.5 px-6">Lessons Learned</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var test in Model.RecoveryTests.OrderByDescending(t => t.TestDate))
                        {
                            var rtoMet = test.ActualRtoMinutes <= Model.RtoMinutes;
                            var rpoMet = test.ActualRpoMinutes <= Model.RpoMinutes;

                            <tr class="hover:bg-[#f4f6f2]/50 transition-colors">
                                <td class="py-3.5 px-6 whitespace-nowrap text-xs font-mono font-semibold text-slate-900">@test.TestDate.ToString("yyyy-MM-dd")</td>
                                <td class="py-3.5 px-6 whitespace-nowrap">
                                    <partial name="Components/_Badge" model='new BadgeModel { Value = test.Result, Type = "result" }' />
                                </td>
                                <td class="py-3.5 px-6 whitespace-nowrap font-mono text-xs">
                                    <span class="font-bold text-slate-900 mr-1.5">@test.ActualRtoMinutes min</span>
                                    <partial name="Components/_Badge" model='new BadgeModel { Value = rtoMet ? "Met" : "Exceeded", ShowDot = false }' />
                                </td>
                                <td class="py-3.5 px-6 whitespace-nowrap font-mono text-xs">
                                    <span class="font-bold text-slate-900 mr-1.5">@test.ActualRpoMinutes min</span>
                                    <partial name="Components/_Badge" model='new BadgeModel { Value = rpoMet ? "Met" : "Exceeded", ShowDot = false }' />
                                </td>
                                <td class="py-3.5 px-6 text-xs text-slate-600 max-w-sm truncate" title="@test.LessonsLearned">
                                    @(string.IsNullOrEmpty(test.LessonsLearned) ? "—" : test.LessonsLearned)
                                </td>
                                <td class="py-3.5 px-6 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1">
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Details", "RecoveryTests", new { id = test.Id }), Variant = "ghost", Size = "icon", Icon = "eye", Title = "Details" }' />
                                        @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                        {
                                            <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", "RecoveryTests", new { id = test.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Tab 4: Recovery Tasks -->
    <div data-tab-panel="tasks" class="hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Assigned Readiness &amp; Remediation Tasks</h3>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <partial name="Components/_Button" model='new ButtonModel { Text = "Create Task", ModalTarget = "createTaskModal", ModalAssetId = Model.Id, Variant = "subtle", Size = "sm", Icon = "plus" }' />
            }
        </div>
        @if (!Model.RecoveryTasks.Any())
        {
            <partial name="Components/_EmptyState" model='new EmptyStateModel {
                Icon = "check-square",
                Title = "No recovery tasks assigned.",
                Subtitle = "Create corrective or preparation action items for this system.",
                ActionText = "Create Task",
                ActionModalTarget = "createTaskModal",
                ActionModalAssetId = Model.Id,
                RequiredRole = "Admin,DRCoordinator"
            }' />
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50/60 text-slate-500 text-[11px] uppercase tracking-wider font-bold">
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6">Task Title</th>
                            <th class="py-3.5 px-6">Assigned To</th>
                            <th class="py-3.5 px-6">Due Date</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var task in Model.RecoveryTasks)
                        {
                            <tr class="hover:bg-[#f4f6f2]/50 transition-colors">
                                <td class="py-3.5 px-6 whitespace-nowrap">
                                    <partial name="Components/_Badge" model='new BadgeModel { Value = task.Status, Type = "status" }' />
                                </td>
                                <td class="py-3.5 px-6 font-semibold text-slate-900 text-xs">@task.Title</td>
                                <td class="py-3.5 px-6 whitespace-nowrap text-xs text-slate-600">@task.AssignedTo</td>
                                <td class="py-3.5 px-6 whitespace-nowrap text-xs font-mono text-slate-500">
                                    @(task.DueDate.HasValue ? task.DueDate.Value.ToString("yyyy-MM-dd") : "—")
                                </td>
                                <td class="py-3.5 px-6 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1">
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Details", "RecoveryTasks", new { id = task.Id }), Variant = "ghost", Size = "icon", Icon = "eye", Title = "Details" }' />
                                        @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                        {
                                            <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", "RecoveryTasks", new { id = task.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
{
    <partial name="Components/Modals/_CreateProcedureModal" />
    <partial name="Components/Modals/_CreateContactModal" />
    <partial name="Components/Modals/_CreateTestModal" />
    <partial name="Components/Modals/_CreateTaskModal" />
}
