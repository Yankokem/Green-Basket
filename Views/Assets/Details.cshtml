@model Green_Basket.Models.Asset
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = Model.Name + " — Recovery Plan";
    Layout = "_Layout";
}

<!-- Top Header with Actions -->
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 pb-5">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <div>
            <div class="flex items-center gap-2.5">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">@Model.Name</h1>
                <partial name="Components/_Badge" model='new BadgeModel { Value = Model.Priority, Type = "priority" }' />
            </div>
            <p class="mt-0.5 text-sm text-slate-500">@Model.Type — Managed by <span class="font-medium text-slate-700">@Model.Owner</span></p>
        </div>
    </div>

    <div class="flex items-center gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg transition-colors shadow-sm">
                <i data-lucide="pencil" class="w-4 h-4 text-slate-500"></i>
                <span>Edit Asset</span>
            </a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition-colors">
                <i data-lucide="trash-2" class="w-4 h-4 text-rose-500"></i>
                <span>Delete</span>
            </a>
        }
    </div>
</div>

<!-- Asset Metrics & Targets Overview Card -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100 shrink-0">
            <i data-lucide="clock" class="w-6 h-6"></i>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Recovery Time Objective (RTO)</span>
            <div class="text-2xl font-bold text-slate-900 mt-0.5">@Model.RtoMinutes <span class="text-sm font-normal text-slate-500">minutes</span></div>
            <p class="text-xs text-slate-400 mt-0.5">Max permissible downtime</p>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100 shrink-0">
            <i data-lucide="database" class="w-6 h-6"></i>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Recovery Point Objective (RPO)</span>
            <div class="text-2xl font-bold text-slate-900 mt-0.5">@Model.RpoMinutes <span class="text-sm font-normal text-slate-500">minutes</span></div>
            <p class="text-xs text-slate-400 mt-0.5">Max acceptable data loss</p>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center border border-purple-100 shrink-0">
            <i data-lucide="hard-drive" class="w-6 h-6"></i>
        </div>
        <div class="overflow-hidden">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Backup Dependency</span>
            <div class="text-sm font-semibold text-slate-900 truncate mt-1" title="@Model.BackupDependency">
                @Model.BackupDependency
            </div>
            <p class="text-xs text-slate-400 mt-0.5">Source needed for recovery</p>
        </div>
    </div>
</div>

<div class="space-y-8">
    <!-- 1. Recovery Procedures Section -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2">
                <i data-lucide="file-text" class="w-4 h-4 text-emerald-600"></i>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Recovery Procedures (@Model.RecoveryProcedures.Count)</h3>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <a asp-controller="RecoveryProcedures" asp-action="Create" asp-route-assetId="@Model.Id" 
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors border border-emerald-200">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>Add Procedure</span>
                </a>
            }
        </div>

        @if (!Model.RecoveryProcedures.Any())
        {
            <div class="p-8 text-center text-slate-400 text-sm">
                No recovery procedures documented for this asset yet.
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var proc in Model.RecoveryProcedures)
                {
                    <div class="p-5 hover:bg-slate-50/50 transition-colors">
                        <div class="flex items-start justify-between">
                            <div>
                                <h4 class="font-bold text-slate-900 text-base flex items-center gap-2">
                                    @proc.Title
                                </h4>
                            </div>
                            <div class="flex items-center gap-2">
                                <a asp-controller="RecoveryProcedures" asp-action="Details" asp-route-id="@proc.Id" class="text-xs text-slate-500 hover:text-emerald-600">View</a>
                                @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                {
                                    <span class="text-slate-300">|</span>
                                    <a asp-controller="RecoveryProcedures" asp-action="Edit" asp-route-id="@proc.Id" class="text-xs text-slate-500 hover:text-amber-600">Edit</a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="text-slate-300">|</span>
                                    <a asp-controller="RecoveryProcedures" asp-action="Delete" asp-route-id="@proc.Id" class="text-xs text-slate-500 hover:text-rose-600">Delete</a>
                                }
                            </div>
                        </div>
                        <div class="mt-3 p-3.5 bg-slate-50 rounded-lg text-slate-700 text-xs font-mono whitespace-pre-line leading-relaxed border border-slate-100">
                            @proc.Steps
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 2. Contacts Section -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2">
                <i data-lucide="users" class="w-4 h-4 text-blue-600"></i>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Key Recovery Contacts (@Model.Contacts.Count)</h3>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <a asp-controller="Contacts" asp-action="Create" asp-route-assetId="@Model.Id" 
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors border border-blue-200">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>Add Contact</span>
                </a>
            }
        </div>

        @if (!Model.Contacts.Any())
        {
            <div class="p-8 text-center text-slate-400 text-sm">
                No emergency contacts linked to this asset.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-4">
                @foreach (var c in Model.Contacts)
                {
                    <div class="p-4 rounded-lg border border-slate-200 bg-slate-50/40 hover:bg-white hover:shadow-sm transition-all flex flex-col justify-between">
                        <div>
                            <div class="flex items-start justify-between">
                                <h4 class="font-bold text-slate-900 text-sm">@c.Name</h4>
                                @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                {
                                    <div class="flex items-center gap-1">
                                        <a asp-controller="Contacts" asp-action="Edit" asp-route-id="@c.Id" class="text-slate-400 hover:text-amber-600 p-1">
                                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="Contacts" asp-action="Delete" asp-route-id="@c.Id" class="text-slate-400 hover:text-rose-600 p-1">
                                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                            <p class="text-xs text-slate-500 font-medium mt-0.5">@c.Role</p>
                        </div>
                        <div class="mt-3 pt-3 border-t border-slate-100 text-xs space-y-1 text-slate-600">
                            <div class="flex items-center gap-2">
                                <i data-lucide="phone" class="w-3 h-3 text-slate-400"></i>
                                <a href="tel:@c.Phone" class="hover:text-emerald-600 font-mono">@c.Phone</a>
                            </div>
                            <div class="flex items-center gap-2">
                                <i data-lucide="mail" class="w-3 h-3 text-slate-400"></i>
                                <a href="mailto:@c.Email" class="hover:text-emerald-600 truncate">@c.Email</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 3. Recovery Tests & RTO/RPO Comparison -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2">
                <i data-lucide="activity" class="w-4 h-4 text-emerald-600"></i>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Disaster Simulation Tests &amp; Lessons Learned</h3>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <a asp-controller="RecoveryTests" asp-action="Create" asp-route-assetId="@Model.Id" 
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors border border-emerald-200">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>Log Test Result</span>
                </a>
            }
        </div>

        @if (!Model.RecoveryTests.Any())
        {
            <div class="p-8 text-center text-slate-400 text-sm">
                No recovery drill test records logged for this asset yet.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/80 text-slate-600 text-xs uppercase tracking-wider font-semibold">
                            <th class="py-3 px-4">Test Date</th>
                            <th class="py-3 px-4">Drill Result</th>
                            <th class="py-3 px-4">Actual RTO vs Target (@Model.RtoMinutes m)</th>
                            <th class="py-3 px-4">Actual RPO vs Target (@Model.RpoMinutes m)</th>
                            <th class="py-3 px-4">Lessons Learned</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var test in Model.RecoveryTests.OrderByDescending(t => t.TestDate))
                        {
                            var rtoMet = test.ActualRtoMinutes <= Model.RtoMinutes;
                            var rpoMet = test.ActualRpoMinutes <= Model.RpoMinutes;

                            <tr class="hover:bg-slate-50/60">
                                <td class="py-3 px-4 whitespace-nowrap text-xs font-medium text-slate-900">
                                    @test.TestDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <partial name="Components/_Badge" model='new BadgeModel { Value = test.Result, Type = "result" }' />
                                </td>
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 font-mono text-xs">
                                        <span class="font-bold">@test.ActualRtoMinutes min</span>
                                        @if (rtoMet)
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[10px] bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">Met</span>
                                        }
                                        else
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[10px] bg-rose-50 text-rose-700 font-semibold border border-rose-200">Exceeded</span>
                                        }
                                    </span>
                                </td>
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 font-mono text-xs">
                                        <span class="font-bold">@test.ActualRpoMinutes min</span>
                                        @if (rpoMet)
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[10px] bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">Met</span>
                                        }
                                        else
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[10px] bg-rose-50 text-rose-700 font-semibold border border-rose-200">Exceeded</span>
                                        }
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-xs text-slate-600 max-w-sm truncate" title="@test.LessonsLearned">
                                    @(string.IsNullOrEmpty(test.LessonsLearned) ? "—" : test.LessonsLearned)
                                </td>
                                <td class="py-3 px-4 text-right whitespace-nowrap">
                                    <a asp-controller="RecoveryTests" asp-action="Details" asp-route-id="@test.Id" class="text-xs text-slate-500 hover:text-emerald-600">Details</a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                    {
                                        <span class="text-slate-300">|</span>
                                        <a asp-controller="RecoveryTests" asp-action="Edit" asp-route-id="@test.Id" class="text-xs text-slate-500 hover:text-amber-600">Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- 4. Recovery Tasks Section -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2">
                <i data-lucide="check-square" class="w-4 h-4 text-amber-600"></i>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Assigned Recovery Tasks (@Model.RecoveryTasks.Count)</h3>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
            {
                <a asp-controller="RecoveryTasks" asp-action="Create" asp-route-assetId="@Model.Id" 
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 rounded-lg transition-colors border border-amber-200">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>Create Task</span>
                </a>
            }
        </div>

        @if (!Model.RecoveryTasks.Any())
        {
            <div class="p-8 text-center text-slate-400 text-sm">
                No active recovery readiness tasks assigned to this asset.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/80 text-slate-600 text-xs uppercase tracking-wider font-semibold">
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4">Task Title</th>
                            <th class="py-3 px-4">Assigned To</th>
                            <th class="py-3 px-4">Due Date</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var task in Model.RecoveryTasks)
                        {
                            <tr class="hover:bg-slate-50/60">
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <partial name="Components/_Badge" model='new BadgeModel { Value = task.Status, Type = "status" }' />
                                </td>
                                <td class="py-3 px-4 font-medium text-slate-900 text-xs">
                                    @task.Title
                                </td>
                                <td class="py-3 px-4 whitespace-nowrap text-xs text-slate-600">
                                    @task.AssignedTo
                                </td>
                                <td class="py-3 px-4 whitespace-nowrap text-xs font-mono text-slate-500">
                                    @(task.DueDate.HasValue ? task.DueDate.Value.ToString("yyyy-MM-dd") : "No due date")
                                </td>
                                <td class="py-3 px-4 text-right whitespace-nowrap">
                                    <a asp-controller="RecoveryTasks" asp-action="Details" asp-route-id="@task.Id" class="text-xs text-slate-500 hover:text-emerald-600">Details</a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                    {
                                        <span class="text-slate-300">|</span>
                                        <a asp-controller="RecoveryTasks" asp-action="Edit" asp-route-id="@task.Id" class="text-xs text-slate-500 hover:text-amber-600">Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
