@model IEnumerable<Green_Basket.Models.Asset>
@using Green_Basket.Models.ViewModels

@{
    ViewData["Title"] = "Hospital Assets";
    Layout = "_Layout";
}

<partial name="Components/_PageHeader" model='new PageHeaderModel {
    Title = "Hospital IT Assets & Criticality",
    Subtitle = "Core clinical, diagnostic, and administrative systems prioritized for disaster recovery restoration.",
    ActionText = "New Asset",
    ActionModalTarget = "createAssetModal",
    ActionIcon = "plus",
    RequiredRole = "Admin,DRCoordinator"
}' />

<div id="assets-table" class="gb-card overflow-hidden">
    <partial name="Components/_TableToolbar" model='new TableToolbarModel {
        TargetId = "assets-table",
        Title = "Registered Systems",
        Count = Model.Count(),
        SearchPlaceholder = "Search assets, type, owner...",
        FilterLabel = "All Priorities",
        FilterOptions = new List<string> { "Critical", "High", "Medium", "Low" },
        RightNote = "Ordered by restore priority (Tier 1 first)"
    }' />

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50/60 text-slate-500 text-[11px] uppercase tracking-wider font-bold">
                    <th class="py-3.5 px-4 whitespace-nowrap">Priority</th>
                    <th class="py-3.5 px-3 whitespace-nowrap">Readiness</th>
                    <th class="py-3.5 px-4 whitespace-nowrap min-w-[200px]">Asset Name &amp; Type</th>
                    <th class="py-3.5 px-3 whitespace-nowrap">System Lead</th>
                    <th class="py-3.5 px-3 whitespace-nowrap">RTO</th>
                    <th class="py-3.5 px-3 whitespace-nowrap">RPO</th>
                    <th class="py-3.5 px-4 whitespace-nowrap min-w-[170px]">Backup Dependency</th>
                    <th class="py-3.5 px-3 text-center whitespace-nowrap">Linked</th>
                    <th class="py-3.5 pr-5 pl-3 text-right whitespace-nowrap">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700 text-sm">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9">
                            <partial name="Components/_EmptyState" model='new EmptyStateModel {
                                Icon = "server",
                                Title = "No assets registered yet.",
                                Subtitle = "Add your first hospital IT system to track recovery targets.",
                                ActionText = "New Asset",
                                ActionModalTarget = "createAssetModal",
                                RequiredRole = "Admin,DRCoordinator"
                            }' />
                        </td>
                    </tr>
                }
                else
                {
                    <tr data-filter-empty class="hidden">
                        <td colspan="9" class="py-12 text-center text-xs text-slate-400">
                            No matching assets found for the current search or priority filter.
                        </td>
                    </tr>
                    @foreach (var item in Model)
                    {
                        <tr data-filter-item
                            data-filter-value="@item.Priority.ToLower()"
                            data-search-text="@($"{item.Name} {item.Type} {item.Owner} {item.BackupDependency} {item.Priority} {item.ReadinessStatus}")"
                            class="hover:bg-[#f4f6f2]/50 transition-colors group">
                            <td class="py-4 px-4 whitespace-nowrap align-middle">
                                <partial name="Components/_Badge" model='new BadgeModel { Value = item.Priority, Type = "priority" }' />
                            </td>

                            <td class="py-4 px-3 whitespace-nowrap align-middle">
                                <partial name="Components/_Badge" model='new BadgeModel { Value = item.ReadinessStatus, Type = "status" }' />
                            </td>

                            <td class="py-4 px-4 align-middle">
                                <a asp-action="Details" asp-route-id="@item.Id" class="font-semibold text-slate-900 group-hover:text-[#426246] transition-colors block text-sm leading-snug">
                                    @item.Name
                                </a>
                                <span class="inline-block text-xs text-slate-500 mt-0.5">@item.Type</span>
                            </td>

                            <td class="py-4 px-3 text-xs font-medium text-slate-700 align-middle whitespace-nowrap">
                                @item.Owner
                            </td>

                            <td class="py-4 px-3 whitespace-nowrap align-middle">
                                <span class="inline-flex items-center gap-1 font-mono text-xs font-semibold px-2 py-1 rounded-lg bg-slate-100/90 text-slate-800 border border-slate-200/70">
                                    <i data-lucide="clock" class="w-3 h-3 text-slate-400"></i>
                                    @item.RtoMinutes m
                                </span>
                            </td>

                            <td class="py-4 px-3 whitespace-nowrap align-middle">
                                <span class="inline-flex items-center gap-1 font-mono text-xs font-semibold px-2 py-1 rounded-lg bg-slate-100/90 text-slate-800 border border-slate-200/70">
                                    <i data-lucide="database" class="w-3 h-3 text-slate-400"></i>
                                    @item.RpoMinutes m
                                </span>
                            </td>

                            <td class="py-4 px-4 text-xs text-slate-600 leading-relaxed align-middle">
                                <span class="line-clamp-2" title="@item.BackupDependency">@item.BackupDependency</span>
                            </td>

                            <td class="py-4 px-3 text-center whitespace-nowrap align-middle">
                                <div class="inline-flex items-center gap-1 text-xs">
                                    <span title="@item.RecoveryProcedures.Count Procedures" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 font-mono">
                                        <i data-lucide="file-text" class="w-3 h-3 text-slate-400"></i>
                                        @item.RecoveryProcedures.Count
                                    </span>
                                    <span title="@item.Contacts.Count Contacts" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 font-mono">
                                        <i data-lucide="users" class="w-3 h-3 text-slate-400"></i>
                                        @item.Contacts.Count
                                    </span>
                                    <span title="@item.RecoveryTests.Count Tests" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 font-mono">
                                        <i data-lucide="activity" class="w-3 h-3 text-slate-400"></i>
                                        @item.RecoveryTests.Count
                                    </span>
                                </div>
                            </td>

                            <td class="py-4 pr-5 pl-3 text-right whitespace-nowrap align-middle">
                                <div class="inline-flex items-center justify-end gap-1">
                                    <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Details", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "eye", Title = "View Recovery Plan", CustomClass = "hover:text-[#426246] hover:bg-[#f4f6f2]" }' />
                                    @if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Edit", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "pencil", Title = "Edit Asset", CustomClass = "hover:text-amber-700 hover:bg-amber-50" }' />
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <partial name="Components/_Button" model='new ButtonModel { Href = Url.Action("Delete", new { id = item.Id }), Variant = "ghost", Size = "icon", Icon = "trash-2", Title = "Delete Asset", CustomClass = "hover:text-rose-700 hover:bg-rose-50" }' />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("DRCoordinator"))
{
    <partial name="Components/Modals/_CreateAssetModal" />
}
